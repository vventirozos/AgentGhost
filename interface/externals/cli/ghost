# --- untrusted text → terminal ---------------------------------------------
# rich strips only BEL/BS/VT/FF/CR (rich.control.STRIP_CONTROL_CODES = [7, 8,
# 11, 12, 13]). ESC is NOT in that set, so every CSI and ST-terminated OSC in
# agent- or server-supplied text reached the terminal RAW — verified:
# \x1b[2J (clear), \x1b[?1049h (alt screen) and \x1b]52;c;<b64>\x1b\\, which
# WRITES THE OPERATOR'S CLIPBOARD. This agent summarizes Tor-fetched pages,
# and the CLI is the only client that renders into a terminal instead of into
# HTML (the web UI and Slack escape by construction), so strip at every point
# where untrusted text becomes output: reply chunks, notices, table cells,
# trimmed previews, titles.
_UNSAFE_CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def _safe(text: Any) -> str:
    """Untrusted text → printable. Keeps newline and tab; drops ESC, the C0
    controls rich lets through, DEL, and the C1 range (U+009B is a one-byte
    CSI, so half-stripping would leave a working escape introducer)."""
    return _UNSAFE_CTRL_RE.sub("", str(text if text is not None else ""))


# --- small formatting helpers ---------------------------------------------

def _ago(ts: float | None) -> str:
    """'42s ago' / '3m ago' / '5h ago' / '2d ago' from an epoch float."""
    if not ts:
        return "—"
    d = max(0.0, time.time() - float(ts))
    if d < 90:
        return f"{d:.0f}s ago"
    if d < 5400:
        return f"{d / 60:.0f}m ago"
    if d < 129600:
        return f"{d / 3600:.0f}h ago"
    return f"{d / 86400:.0f}d ago"


def _dur(seconds: float | None) -> str:
    if seconds is None:
        return "—"
    s = int(seconds)
    if s < 90:
        return f"{s}s"
    if s < 5400:
        return f"{s // 60}m {s % 60}s"
    if s < 129600:
        return f"{s // 3600}h {s % 3600 // 60}m"
    return f"{s // 86400}d {s % 86400 // 3600}h"


def _trim(text: Any, width: int) -> str:
    text = " ".join(_safe(text).split())
    return text if len(text) <= width else text[: width - 1] + "…"


def _table(headers: list[str], rows: list[list[str]]) -> None:
    """Muted-header, borderless table, aligned to the gutter. Cells are plain
    text (never parsed as rich markup — titles/previews can contain
    anything)."""
    if not rows:
        return
    t = Table(box=None, header_style="mute", pad_edge=False,
              padding=(0, 2, 0, 0))
    for h in headers:
        t.add_column(h)
    for r in rows:
        t.add_row(*[Text(_safe(c)) for c in r])
    console.print(Padding(t, (0, 0, 0, GUTTER)))


def _fit_line(head: list, optional: list[list], tail: Text | None = None,
              width: int | None = None) -> Text:
    """``head`` + as many ``optional`` groups as fit + ``tail``, dropping
    optional groups from the TAIL until the line fits the terminal.

    Chrome that wraps is worse than chrome that says less: the old banner
    assembled every segment unconditionally and spilled onto a second line
    in any window narrower than its content. Both the banner and its hint
    line go through this, so they cannot drift apart in how they degrade."""
    w = console.width if width is None else width
    groups = list(optional)
    while True:
        parts = list(head)
        for group in groups:
            parts.extend(group)
        line = Text.assemble(*parts)
        if tail is not None:
            line.append_text(tail)
        if line.cell_len <= w - 1:
            return line
        if not groups:
            # Nothing optional left and it STILL doesn't fit (a very narrow
            # window, or a long hostname). Truncating is the guarantee —
            # without it the invariant held only while something remained
            # to drop, which is exactly when it stops being tested.
            line.truncate(max(1, w - 1), overflow="ellipsis")
            return line
        groups.pop()          # drop the least important survivor, retry


def _rule(width: int | None = None) -> Text:
    """A separator that spans the terminal. It used to be a hardcoded 52
    characters, so it under-ran a wide window and the banner it belonged to
    WRAPPED in a narrow one."""
    w = max(8, (width if width is not None else console.width) - GUTTER * 2)
    return Text(" " * GUTTER + "─" * w, style="faint")


def _flush_point(text: str, start: int) -> int:
    """Index just past the LAST markdown block boundary (a blank line at
    even code-fence parity) in ``text[start:]`` — everything before it is
    a COMPLETE block that can be printed permanently. ``start`` when no
    complete block is pending. Scans only the pending region, so the cost
    over a whole stream is linear."""
    point = start
    in_fence = False
    pos = start
    while True:
        nl = text.find("\n", pos)
        if nl == -1:
            break
        line = text[pos:nl]
        if line.lstrip().startswith(("```", "~~~")):
            in_fence = not in_fence
        if not in_fence and not line.strip():
            point = nl + 1
        pos = nl + 1
    return point


class _StreamPrinter:
    """Progressive streaming renderer: the reply FLOWS INTO THE NORMAL
    SCROLL like any terminal program (operator requirement — "use the
    whole screen"), fully markdown-rendered, with no settle-time reprint.

    Completed blocks print permanently the moment their boundary arrives
    (rich routes prints ABOVE an active Live region); only the current
    in-progress block rides a small transient tail. This keeps the two
    hard constraints compatible: markdown can't re-render lines already
    printed (so only FINISHED blocks may print), and a Live region can't
    exceed the screen (so only the UNFINISHED block may live there —
    it is naturally small; _TailCrop guards the rare giant one)."""

    def __init__(self) -> None:
        self.text = ""
        self.upto = 0
        self.live: Live | None = None

    def feed(self, chunk: str) -> None:
        # THE choke point for the rendered path: everything the agent says
        # becomes terminal output here, and self.text is what the caller
        # keeps as history / hands to /save. Sanitizing at the call sites
        # instead would leave the guard one refactor away from being
        # bypassed by a new one.
        self.text += _safe(chunk)
        fp = _flush_point(self.text, self.upto)
        if fp > self.upto:
            segment = self.text[self.upto:fp]
            if segment.strip():
                console.print(_reply_block(segment))
                console.print()   # inter-block spacing rich would have added
            self.upto = fp
        pending = self.text[self.upto:]
        if pending.strip():
            if self.live is None:
                self.live = Live(console=console, refresh_per_second=12,
                                 transient=True)
                self.live.start()
            # _LazyMarkdown, not Markdown: parsing here re-parsed the whole
            # pending region on EVERY chunk, and when a reply has no blank
            # line to flush on — a table, a long bullet list — the pending
            # region IS the whole reply. Measured: a 400-row table cost
            # 12.24s against 0.07s for the same volume of prose, with
            # markdown_it.parse accounting for 14.6s of a 16.9s profile
            # (1410 calls, one per chunk). Deferred, the parse runs on
            # Live's refresh clock (12/s) instead of the token rate.
            self.live.update(_TailCrop(_LazyMarkdown(pending)))

    def settle(self) -> None:
        """Stop the live tail and print whatever block was still open —
        idempotent, safe from error/abort paths."""
        if self.live is not None:
            self.live.stop()
            self.live = None
        rest = self.text[self.upto:]
        self.upto = len(self.text)
        if rest.strip():
            console.print(_reply_block(rest))


def _reply_block(markup: str) -> Padding:
    """One block of the agent's reply, on the gutter. Every path that prints
    reply text goes through here so the transcript keeps one left edge — the
    settled blocks, the still-open tail, and the end-of-stream flush.

    A plain indent, deliberately: a coloured left rail would mark every
    reply line as the agent's, but it also prefixes every line the operator
    copies out of the terminal. Copy-clean won."""
    return Padding(Markdown(markup, code_theme=CODE_THEME),
                   (0, 0, 0, GUTTER))


class _LazyMarkdown:
    """Markdown parsed at RENDER time rather than at update time.

    ``Live.update()`` is called once per streamed chunk but rich only
    RENDERS on its own refresh tick, so building the Markdown object in
    ``feed()`` paid a full markdown_it parse per token for a document that
    was thrown away unrendered ~90% of the time. Holding the markup and
    parsing inside ``__rich_console__`` moves that cost onto the refresh
    clock. Kept separate from _TailCrop so the crop stays a plain
    renderable wrapper (and its own tests keep testing only cropping)."""

    def __init__(self, markup: str):
        self.markup = markup

    def __rich_console__(self, console: Console,
                         options: ConsoleOptions) -> RenderResult:
        yield _reply_block(self.markup)


class _TailCrop:
    """Stream-safe live view: the last rendered lines that fit the screen.

    A Live region taller than the terminal cannot be repainted — the cursor
    can't move above the top row, so each refresh erases only the top
    screenful, reprints the whole reply from the clamp point, and pushes a
    stale partial frame into scrollback (the "erratic / half-screen"
    transcripts on long replies; mid-stream markdown aggravates it — an
    unclosed ``` fence transiently renders everything after it as one tall
    code block). Cropping the live view to the tail keeps the region
    repaintable at any reply length; the FULL reply is printed once after
    the stream settles. rich's own crop/ellipsis overflow modes keep the
    TOP lines — the wrong end for chat."""

    def __init__(self, renderable: Any):
        self.renderable = renderable

    def __rich_console__(self, console: Console,
                         options: ConsoleOptions) -> RenderResult:
        lines = console.render_lines(self.renderable, options, pad=False)
        # A THIRD of the screen, not height-2: a region sized to ~the full
        # screen only repaints cleanly when it STARTS at the very top row —
        # true for the first turn of a fresh session (how this was tested)
        # and false for every turn after it (cursor starts mid-screen, the
        # region overflows the bottom, and the terminal's clamped partial
        # repaints shred mid-screen — operator report 2026-08-01: "finishes
        # at the middle of the screen" on long replies). A compact tail
        # fits below any reasonable start position; the FULL reply still
        # prints once at settle.
        max_h = max(8, min(options.size.height - 2,
                           options.size.height // 3))
        if len(lines) > max_h:
            lines = lines[-max_h:]
        new_line = Segment.line()
        for i, line in enumerate(lines):
            if i:
                yield new_line
            yield from line


# --- inline terminal images -------------------------------------------------
# Replies reference agent-generated images as markdown (`![…](name.png)`,
# sandbox-relative — the same references the web UI and uConsole resolve via
# GET /api/download/{name}). Rendering happens AFTER the live region settles:
# the iTerm2/kitty escapes are raw byte streams that a rich Live repaint
# would shred, so images are drawn below the finished reply, in reference
# order. Half-block is the everywhere-fallback: two vertical pixels per
# character cell via '▀' with truecolor fg/bg — coarse but genuinely inline.

_IMG_MD_RE = re.compile(r'!\[[^\]]*\]\(([^)\s]+)\)')
_IMG_EXTS = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp")
_IMG_MAX_BYTES = 25 * 1024 * 1024
_IMG_MAX_PER_REPLY = 4
_PNG_MAGIC = b"\x89PNG\r\n\x1a\n"


def _pil():
    """Pillow, or None — optional at runtime. The escape protocols ship raw
    file bytes and work without it; half-block (and kitty transcoding of
    non-PNG formats) need it."""
    try:
        from PIL import Image
        return Image
    except Exception:  # noqa: BLE001 — absence is a supported state
        return None


def _in_tmux() -> bool:
    return bool(os.environ.get("TMUX")) or \
        (os.environ.get("TERM") or "").startswith(("screen", "tmux"))


def _tmux_supports_sixel() -> bool:
    """tmux ≥3.4 built with sixel treats a sixel image as part of its own
    grid and REPAINTS it on resize/pane-switch — the persistence that
    passthrough overlays fundamentally can't have (tmux redraws from its
    character cells; an OSC-1337 image is an iTerm2 overlay it never knew
    about, so any redraw erases it — operator report 2026-07-17).
    Version is a proxy for the build flag (Homebrew enables sixel since
    3.4); a sixel-less custom build would print garbage — GHOST_CLI_IMAGES
    overrides exist for that case."""
    try:
        import subprocess
        v = subprocess.run(["tmux", "-V"], capture_output=True, text=True,
                           timeout=3).stdout.strip()
        m = re.search(r"(\d+)\.(\d+)", v)
        return bool(m) and (int(m.group(1)), int(m.group(2))) >= (3, 4)
    except Exception:  # noqa: BLE001 — no tmux binary / weird output
        return False


_TMUX_CELL_CACHE: tuple[int, int] | None = None


def _tmux_cell_px() -> tuple[int, int]:
    """(cell_width_px, cell_height_px) as tmux reports for the attached
    client — the ground truth for how many GRID CELLS a sixel image
    occupies. Cached per process; conservative defaults when the query
    fails."""
    global _TMUX_CELL_CACHE
    if _TMUX_CELL_CACHE is None:
        w, h = 10, 20
        try:
            import subprocess
            out = subprocess.run(
                ["tmux", "display", "-p",
                 "#{client_cell_width} #{client_cell_height}"],
                capture_output=True, text=True, timeout=3,
            ).stdout.split()
            if len(out) == 2 and int(out[0]) > 0 and int(out[1]) > 0:
                w, h = int(out[0]), int(out[1])
        except Exception:  # noqa: BLE001 — defaults are safe
            pass
        _TMUX_CELL_CACHE = (w, h)
    return _TMUX_CELL_CACHE


def _outer_term_sixel_capable() -> bool:
    """Best-effort: is the terminal BEHIND tmux one we know renders
    sixel? tmux ≥3.3 masks TERM_PROGRAM as 'tmux', but iTerm2's
    LC_TERMINAL usually survives into panes."""
    return (os.environ.get("LC_TERMINAL") == "iTerm2"
            or os.environ.get("TERM_PROGRAM") in ("iTerm.app", "WezTerm"))


def _term_image_mode() -> str:
    """'iterm' | 'kitty' | 'halfblock' | 'none'. GHOST_CLI_IMAGES overrides
    detection (off/iterm/kitty/halfblock); ssh carries LC_TERMINAL for
    iTerm2. Detection is env-only — no terminal round-trips.

    Under tmux the escape protocols are NOT auto-selected: tmux swallows
    them unless `allow-passthrough` is on (off by default since 3.3), and
    a swallowed escape looks like "no image at all" (operator report,
    2026-07-17, tmux-on-iTerm2). Half-block always shows. An explicit
    GHOST_CLI_IMAGES=iterm|kitty opts back in — the emitters then wrap
    sequences in tmux passthrough framing."""
    override = (os.environ.get("GHOST_CLI_IMAGES") or "").strip().lower()
    if override in ("off", "none", "0", "false"):
        return "none"
    if override in ("iterm", "kitty", "halfblock", "sixel"):
        return override
    if not sys.stdout.isatty():
        return "none"
    if _in_tmux():
        # Sixel when the whole stack supports it (redraw-persistent);
        # half-block otherwise (always visible, survives redraws too).
        if _pil() and _outer_term_sixel_capable() and _tmux_supports_sixel():
            return "sixel"
        return "halfblock" if _pil() else "none"
    if (os.environ.get("TERM_PROGRAM") in ("iTerm.app", "WezTerm")
            or os.environ.get("LC_TERMINAL") == "iTerm2"):
        return "iterm"
    if (os.environ.get("KITTY_WINDOW_ID")
            or "kitty" in (os.environ.get("TERM") or "")):
        return "kitty"
    return "halfblock" if _pil() else "none"


_REF_PREFIXES = ("/api/download/", "api/download/", "/workspace/",
                 "workspace/", "sandbox:/", "sandbox/")


def _normalize_image_ref(ref: str) -> str:
    """Map whatever the model wrote to the sandbox-relative name
    /api/download expects. Live 2026-07-17: the reply embedded the FULL
    API path (`![…](/api/download/gen_x.png)`), so the fetch built
    /api/download//api/download/… → 404. Absolute workspace paths and
    sandbox: pseudo-schemes get the same treatment."""
    ref = ref.strip().strip("'\"")
    low = ref.lower()
    for pfx in _REF_PREFIXES:
        if low.startswith(pfx):
            ref = ref[len(pfx):]
            break
    return ref.lstrip("/")


def _extract_image_refs(text: str) -> list[str]:
    """Sandbox-relative image paths referenced by the reply — image
    extensions only, schemes (http/attachment/data) skipped (the CLI only
    fetches from the agent), de-duplicated in order, capped."""
    out: list[str] = []
    for ref in _IMG_MD_RE.findall(text or ""):
        ref = ref.strip().strip("'\"")
        if not ref or "://" in ref or ref.startswith("data:"):
            continue
        ref = _normalize_image_ref(ref)
        if not ref or not ref.lower().endswith(_IMG_EXTS):
            continue
        if ref not in out:
            out.append(ref)
    return out[:_IMG_MAX_PER_REPLY]


def _image_cells() -> int:
    return max(20, min(console.width - 4, 100))


def _emit_raw(seq: str) -> None:
    """Escape sequences must bypass rich's markup/width machinery. Under
    tmux (explicit GHOST_CLI_IMAGES=iterm|kitty — auto-detection avoids
    tmux) the sequence is wrapped in DCS passthrough framing with ESC
    doubled, the same trick iTerm2's imgcat uses; tmux ≥3.3 additionally
    needs `set -g allow-passthrough on` in .tmux.conf."""
    if _in_tmux() and seq.startswith("\x1b"):
        seq = "\x1bPtmux;" + seq.replace("\x1b", "\x1b\x1b") + "\x1b\\"
    sys.stdout.write(seq)
    sys.stdout.flush()


def _render_iterm(data: bytes, name: str) -> bool:
    b64 = base64.b64encode(data).decode("ascii")
    b64name = base64.b64encode(name.encode("utf-8", "replace")).decode("ascii")
    _emit_raw(
        f"\x1b]1337;File=name={b64name};size={len(data)};inline=1;"
        f"width={_image_cells()};preserveAspectRatio=1:{b64}\x07\n"
    )
    return True


def _render_kitty(data: bytes, name: str) -> bool:
    """Kitty graphics protocol (a=T direct transmit). f=100 is PNG-only —
    other formats are transcoded via Pillow or skipped."""
    if not data.startswith(_PNG_MAGIC):
        Image = _pil()
        if Image is None:
            return False
        import io
        try:
            buf = io.BytesIO()
            Image.open(io.BytesIO(data)).convert("RGB").save(buf, "PNG")
            data = buf.getvalue()
        except Exception:  # noqa: BLE001 — undecodable → let caller fall back
            return False
    b64 = base64.b64encode(data).decode("ascii")
    chunks = [b64[i:i + 4096] for i in range(0, len(b64), 4096)] or [""]
    for i, chunk in enumerate(chunks):
        more = 0 if i == len(chunks) - 1 else 1
        ctrl = (f"a=T,f=100,c={_image_cells()},m={more}" if i == 0
                else f"m={more}")
        _emit_raw(f"\x1b_G{ctrl};{chunk}\x1b\\")
    _emit_raw("\n")
    return True


def _render_sixel(data: bytes, name: str) -> bool:
    """DEC sixel, pure-python (Pillow quantize → ≤256-color palette →
    6-row bands with run-length encoding). Emitted RAW even under tmux —
    a sixel-built tmux consumes the sequence itself and OWNS the image
    (that's the whole point: it survives resizes); passthrough framing
    would hide it from tmux and reintroduce the overlay problem."""
    Image = _pil()
    if Image is None:
        return False
    import io
    try:
        img = Image.open(io.BytesIO(data)).convert("RGB")
    except Exception:  # noqa: BLE001 — undecodable bytes
        return False
    # Size by REAL cell geometry under tmux — sixel pixels map to the
    # client's pixels, and an image wider than cols×cell_width px gets
    # clipped by the pane (18×8 cells measured live on the operator's
    # setup; the old 10px/cell guess overflowed the pane by ~25%).
    cell_w, cell_h = _tmux_cell_px() if _in_tmux() else (10, 20)
    max_w = min(_image_cells(), 80) * cell_w
    if img.width > max_w:
        img = img.resize(
            (max_w, max(1, round(img.height * max_w / img.width))))
    pal_img = img.quantize(colors=256)
    W, H = pal_img.size
    palette = pal_img.getpalette() or []
    pix = list(pal_img.getdata())                  # flat, row-major
    parts = [f"\x1bPq\"1;1;{W};{H}"]
    ncolors = max(pix) + 1 if pix else 1
    for i in range(ncolors):
        r, g, b = (palette[3 * i:3 * i + 3] + [0, 0, 0])[:3]
        parts.append(f"#{i};2;{r * 100 // 255};{g * 100 // 255};"
                     f"{b * 100 // 255}")
    for y0 in range(0, H, 6):
        rows = min(6, H - y0)
        band = [pix[(y0 + dy) * W:(y0 + dy) * W + W] for dy in range(rows)]
        colors = set()
        for row in band:
            colors.update(row)
        first = True
        for c in sorted(colors):
            if not first:
                parts.append("$")                  # overprint next color
            first = False
            parts.append(f"#{c}")
            run_ch, run_len, seq = None, 0, []
            for x in range(W):
                bits = 0
                for dy in range(rows):
                    if band[dy][x] == c:
                        bits |= 1 << dy
                ch = chr(63 + bits)
                if ch == run_ch:
                    run_len += 1
                else:
                    if run_ch is not None:
                        seq.append(run_ch if run_len == 1
                                   else f"!{run_len}{run_ch}")
                    run_ch, run_len = ch, 1
            if run_ch is not None:
                seq.append(run_ch if run_len == 1 else f"!{run_len}{run_ch}")
            parts.append("".join(seq))
        parts.append("-")                          # next 6-pixel band
    parts.append("\x1b\\")
    tail = "\n"
    if _in_tmux():
        # tmux anchors the image to the grid at the cursor WITHOUT
        # advancing it. The caption printed next would land ON the
        # image's cells — and tmux invalidates an image whose cells are
        # overwritten, so it vanished before it could be seen (live
        # report: "doesn't really show at all"). Advance the cursor past
        # the image's full cell height first.
        tail = "\n" * (-(-H // cell_h) + 1)
    sys.stdout.write("".join(parts) + tail)
    sys.stdout.flush()
    return True


def _render_halfblock(data: bytes, name: str) -> bool:
    Image = _pil()
    if Image is None:
        return False
    import io
    try:
        img = Image.open(io.BytesIO(data)).convert("RGB")
    except Exception:  # noqa: BLE001 — undecodable bytes
        return False
    cols = min(_image_cells(), 80)
    # A terminal cell is ~2:1 (h:w); '▀' packs two pixel rows per cell, so
    # rows_px = cols * (h/w) * cell-aspect ≈ cols * h/w * 0.9, even-rounded.
    rows_px = max(2, round(cols * (img.height / max(1, img.width)) * 0.9))
    rows_px += rows_px % 2
    img = img.resize((cols, rows_px))
    px = img.load()
    for y in range(0, rows_px, 2):
        line = Text()
        for x in range(cols):
            r1, g1, b1 = px[x, y]
            r2, g2, b2 = px[x, y + 1]
            line.append("▀", style=f"rgb({r1},{g1},{b1}) on rgb({r2},{g2},{b2})")
        console.print(line)
    return True


def render_image_bytes(name: str, data: bytes,
                       mode: str | None = None) -> bool:
    """Draw one image inline. Falls through iterm/kitty → halfblock when a
    protocol path can't handle the bytes. Returns True when something was
    drawn. Never raises — an undrawable image is a notice, not a crash."""
    mode = mode or _term_image_mode()
    if mode == "none" or not data:
        return False
    try:
        drawn = (mode == "iterm" and _render_iterm(data, name)) \
            or (mode == "kitty" and _render_kitty(data, name)) \
            or (mode == "sixel" and _render_sixel(data, name)) \
            or (mode == "halfblock" and _render_halfblock(data, name))
        if not drawn and mode in ("iterm", "kitty", "sixel"):
            drawn = _render_halfblock(data, name)
        if drawn:
            console.print(Text(f"  🖼 {name} · {len(data):,} bytes",
                               style="mute"))
        return drawn
    except Exception as e:  # noqa: BLE001 — rendering is best-effort
        console.print(Text(f"  🖼 {name}: could not render "
                           f"({type(e).__name__})", style="mute"))
        return False


def render_reply_images(api: "GhostAPI", text: str) -> None:
    """Fetch + draw every image the reply references. Quiet on a clean
    reply; one mute line per fetch failure so a missing file never looks
    like a rendering bug."""
    mode = _term_image_mode()
    if mode == "none":
        return
    for ref in _extract_image_refs(text):
        try:
            status, data = api.download_bytes(ref)
            # The reply's path may not match the sandbox layout (scoped
            # project dirs, stale prefixes) — the flat basename is where
            # generated images actually land, so try it before giving up.
            if (status != 200 or not data) and "/" in ref:
                base = ref.rsplit("/", 1)[1]
                status, data = api.download_bytes(base)
                if status == 200 and data:
                    ref = base
        except requests.RequestException:
            status, data = 0, b""
        if status != 200 or not data:
            console.print(Text(f"  🖼 {ref}: not fetchable from the sandbox "
                               f"(HTTP {status})", style="mute"))
            continue
        render_image_bytes(ref, data, mode)


