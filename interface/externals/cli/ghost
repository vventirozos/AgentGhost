class GhostAPI:
    """Thin typed wrapper over the agent's HTTP surface."""

    def __init__(self, base_url: str, api_key: str):
        # Reduce to scheme://host:port — request paths are appended, so a
        # stray path/query on base_url would build a malformed URL (→ 405).
        raw = str(base_url or "").strip()
        p = urlparse(raw)
        if p.scheme not in ("http", "https") or not p.netloc:
            # GHOST_URL=eva:8000 parses as scheme='eva', netloc='' — it fell
            # through to the raw string and every call then died with a bare
            # MissingSchema instead of just working. Assume http.
            p = urlparse("http://" + raw.split("://", 1)[-1])
        self.base_url = (f"{p.scheme}://{p.netloc}" if p.netloc
                         else raw.rstrip("/"))
        self.http = requests.Session()
        self.http.headers["X-Ghost-Key"] = api_key

    @staticmethod
    def _stream_to_file(resp: requests.Response, dest: Path) -> int:
        """Stream a 200 body into ``dest`` via a sibling temp file and one
        atomic rename. ``dest`` is not touched unless the WHOLE body
        arrived, and the only thing ever unlinked is our own temp file.

        Both halves were bugs. A transfer that died mid-stream left a
        truncated file over the operator's original; and the callers
        "cleaned up" a failure with dest.unlink(), which deleted a
        PRE-EXISTING local file the CLI had never written — verified:
        `/download report.pdf` against a 404 removed the operator's own
        report.pdf."""
        tmp = dest.with_name(f".{dest.name}.part-{uuid.uuid4().hex[:8]}")
        written = 0
        try:
            with tmp.open("wb") as fh:
                for chunk in resp.iter_content(65536):
                    fh.write(chunk)
                    written += len(chunk)
            os.replace(tmp, dest)
        except BaseException:      # KeyboardInterrupt included, deliberately
            tmp.unlink(missing_ok=True)
            raise
        return written

    def _url(self, path: str) -> str:
        return f"{self.base_url}{path}"

    def _json(self, method: str, path: str, *, body: dict | None = None,
              params: dict | None = None, files: dict | None = None,
              timeout: tuple = (10, 60)) -> tuple[int, Any]:
        """One JSON round-trip → (status_code, parsed body). Non-JSON bodies
        come back as {'raw': text} so callers never need a second parse."""
        r = self.http.request(method, self._url(path), json=body,
                              params=params, files=files, timeout=timeout)
        try:
            return r.status_code, r.json()
        except ValueError:
            return r.status_code, {"raw": (r.text or "").strip()[:300]}

    @staticmethod
    def error_of(data: Any) -> str:
        """Human message out of any of the agent's error shapes:
        {'error': {'message': ...}} / {'error': str} / {'detail': ...} / raw."""
        if isinstance(data, dict):
            err = data.get("error")
            if isinstance(err, dict):
                return str(err.get("message") or err)
            if err:
                return str(err)
            return str(data.get("detail") or data.get("raw") or data)
        return str(data)

    # -- chat --------------------------------------------------------------
    def chat_stream(self, messages: list[dict], session_id: str,
                    request_id: str) -> requests.Response:
        return self.http.post(
            self._url("/v1/chat/completions"),
            json={"messages": messages, "stream": True,
                  "session_id": session_id},
            headers={"X-Request-ID": request_id},
            stream=True, timeout=(10, None),   # connect 10s; agent ends the read
        )

    # -- sessions ------------------------------------------------------------
    def sessions_list(self, limit: int = 50) -> tuple[int, Any]:
        return self._json("GET", "/api/sessions", params={"limit": limit})

    def session_get(self, sid: str) -> tuple[int, Any]:
        return self._json("GET", f"/api/sessions/{quote(sid, safe='')}")

    def session_create(self, title: str = "") -> tuple[int, Any]:
        return self._json("POST", "/api/sessions", body={"title": title})

    def session_delete(self, sid: str) -> tuple[int, Any]:
        return self._json("DELETE", f"/api/sessions/{quote(sid, safe='')}")

    # -- turns / ops -----------------------------------------------------------
    def turns(self) -> tuple[int, Any]:
        return self._json("GET", "/api/turns")

    def cancel_turn(self, request_id: str | None = None,
                    hard: bool = False) -> tuple[int, Any]:
        return self._json("POST", "/api/turn/cancel",
                          body={"request_id": request_id, "hard": hard})

    def feedback(self, request_id: str, signal: str, note: str = "",
                 source: str = FEEDBACK_SOURCE) -> tuple[int, Any]:
        """Human outcome label for one completed turn. ``signal`` is
        'positive'|'negative'; ``note`` on a negative becomes the
        trajectory's failure_reason (the agent caps it at 500 chars and
        redacts it before logging — cap here too so the wire matches)."""
        return self._json("POST", "/api/feedback",
                          body={"request_id": request_id, "signal": signal,
                                "note": note[:500], "source": source},
                          timeout=RATE_TIMEOUT)

    def health(self, timeout: tuple = (10, 30)) -> tuple[int, Any]:
        return self._json("GET", "/api/health", timeout=timeout)

    def notifications(self, consumer: str, limit: int = 50) -> tuple[int, Any]:
        return self._json("GET", "/api/notifications/pending",
                          params={"consumer": consumer, "limit": limit})

    def notifications_ack(self, consumer: str, watermark: int) -> tuple[int, Any]:
        return self._json("POST", "/api/notifications/ack",
                          body={"consumer": consumer, "watermark": watermark})

    def memory_correct(self, match: str, replacement: str) -> tuple[int, Any]:
        return self._json("POST", "/api/memory/correct",
                          body={"match": match, "replacement": replacement})

    def memory_delete(self, match: str) -> tuple[int, Any]:
        return self._json("POST", "/api/memory/delete", body={"match": match})

    # -- files / workspace ------------------------------------------------------
    def upload(self, path: Path) -> tuple[int, Any]:
        with path.open("rb") as fh:
            return self._json("POST", "/api/upload",
                              files={"file": (path.name, fh)},
                              timeout=(10, 600))

    def download_bytes(self, name: str,
                       cap: int = _IMG_MAX_BYTES) -> tuple[int, bytes]:
        """Fetch a sandbox file into memory (inline image rendering).
        Returns (status, bytes) — bytes empty on error or when ``cap`` is
        exceeded (a runaway file must not balloon the CLI)."""
        with self.http.get(self._url(f"/api/download/{quote(name)}"),
                           stream=True, timeout=(10, 120)) as r:
            if r.status_code != 200:
                return r.status_code, b""
            buf = bytearray()
            for chunk in r.iter_content(65536):
                buf.extend(chunk)
                if len(buf) > cap:
                    return 200, b""
            return 200, bytes(buf)

    def download(self, name: str, dest: Path) -> tuple[int, int]:
        """Stream a sandbox file to ``dest``. Returns (status, bytes_written).
        A non-200 leaves ``dest`` untouched — see _stream_to_file."""
        with self.http.get(self._url(f"/api/download/{quote(name)}"),
                           stream=True, timeout=(10, 600)) as r:
            if r.status_code != 200:
                return r.status_code, 0
            return 200, self._stream_to_file(r, dest)

    def workspace_save(self, history: list[dict], dest: Path) -> tuple[int, int]:
        with self.http.post(self._url("/api/workspace/save"),
                            json={"chat_history": history},
                            stream=True, timeout=(10, 600)) as r:
            if r.status_code != 200:
                return r.status_code, 0
            return 200, self._stream_to_file(r, dest)

    def workspace_load(self, path: Path) -> tuple[int, Any]:
        with path.open("rb") as fh:
            return self._json("POST", "/api/workspace/load",
                              files={"file": (path.name, fh)},
                              timeout=(10, 600))

    # -- projects ---------------------------------------------------------------
    def projects_list(self) -> tuple[int, Any]:
        return self._json("GET", "/api/projects")

    def project_get(self, pid: str) -> tuple[int, Any]:
        return self._json("GET", f"/api/projects/{quote(pid, safe='')}")

    def project_create(self, title: str, goal: str = "") -> tuple[int, Any]:
        return self._json("POST", "/api/projects",
                          body={"title": title, "goal": goal})

    def project_switch(self, pid: str) -> tuple[int, Any]:
        return self._json("POST", f"/api/projects/{quote(pid, safe='')}/switch")

    def project_resume(self, pid: str) -> tuple[int, Any]:
        return self._json("POST", f"/api/projects/{quote(pid, safe='')}/resume")

    def project_advance(self, pid: str) -> tuple[int, Any]:
        # An advance runs a full agent task — allow it to take its time.
        return self._json("POST", f"/api/projects/{quote(pid, safe='')}/advance",
                          timeout=(10, 900))

    def project_tasks(self, pid: str) -> tuple[int, Any]:
        return self._json("GET", f"/api/projects/{quote(pid, safe='')}/tasks")


class GhostCLI:
    def __init__(self, api: GhostAPI, session_id: str | None = None):
        self.api = api
        self.history: list[dict] = []
        # Durable server-side session: the agent persists every turn under
        # this id (created lazily on first append), so any client can resume
        # it later. Must match the server's ^[A-Za-z0-9_-]{1,64}$ rule.
        self.session_id = session_id or uuid.uuid4().hex
        # Built lazily in chat(): constructing a PromptSession on a non-tty
        # stdin (e.g. `ghost --health` from a script) warns on stderr.
        self.prompt_session: PromptSession | None = None
        # Rateable replies, oldest → newest — one ref per reply THIS client
        # streamed. A /resume'd or /load'ed history carries no request ids,
        # so it contributes none (see _reset_turn_refs).
        self.turns: list[dict] = []
        self._rate_hinted = False
        # Set by stream_reply: "" | "cancelled" | "error". A turn the agent
        # never finished is not rateable — see cmd_rate.
        self._turn_interrupted = ""

    # -- presentation ----------------------------------------------------
    def banner(self) -> None:
        """Identity, endpoint, session and liveness on ONE line that never
        wraps, over a rule that spans the window.

        The old banner hardcoded a 52-column rule and unconditionally
        assembled the full URL, the session id and 'up 3h 20m' — so it
        under-ran a wide terminal and WRAPPED in a narrow one, which is
        what the operator saw first, every time."""
        console.print()
        console.print(self._banner_line(console.width))
        console.print(_rule())
        console.print(self._hint_line(console.width))
        console.print()

    def _banner_line(self, width: int) -> Text:
        """Identity and liveness are never what gets cut; the endpoint and
        the session id are, in that order, as the window narrows."""
        host = self.api.base_url.split("://", 1)[-1]
        sep = ("  ·  ", "faint")
        probe = Text("  ·  ", style="faint")
        probe.append_text(self._probe())
        return _fit_line(
            head=[("  👻 ghost", "bold ghost")],
            optional=[[sep, (host, "mute")],
                      [sep, (self.session_id[:8], "faint")]],
            tail=probe, width=width)

    def _hint_line(self, width: int) -> Text:
        return _fit_line(
            head=[("  /help", "you")],
            optional=[[("  ·  Tab completes", "faint")],
                      [("  ·  ", "faint"), ("Ctrl-D", "mute"),
                       (" exits", "faint")]],
            width=width)

    def _probe(self) -> Text:
        """One cheap health ping for the banner: reachability + key check."""
        try:
            status, data = self.api.health(timeout=(2, 5))
        except requests.RequestException:
            return Text("○ unreachable", style="err")
        if status == 200:
            # Compact ("3h20m", not "up 3h 20m") — this is the segment the
            # banner can least afford to spend width on.
            up = _dur(data.get("uptime_s")).replace(" ", "")
            return Text.assemble(("● online", "ok"), (f" {up}", "faint"))
        if status == 403:
            return Text("● key rejected", style="err")
        return Text(f"● HTTP {status}", style="notice")

    @staticmethod
    def notice(msg: str, style: str = "notice") -> None:
        # Text() keeps the message literal — never parsed as rich markup
        # (error details / titles can contain anything, including brackets).
        # _safe() additionally strips ESC/C1: server error prose reaches here
        # verbatim, and rich does not strip escape introducers.
        # Indented to the gutter so notices share the transcript's left edge
        # with replies and tables.
        console.print(Text(" " * GUTTER + _safe(msg), style=style))

    def fail(self, status: int, data: Any) -> None:
        self.notice(f"✖ HTTP {status}: {self.api.error_of(data)}", "err")

    # -- chat turn ---------------------------------------------------------
    def stream_reply(self, request_id: str) -> str:
        """POST the history and render the streamed reply live as Markdown.
        Returns its text (possibly partial, if aborted) so the caller can
        keep context."""
        status_spin = console.status(Text("thinking…", style="faint"),
                                     spinner="dots")
        status_spin.start()
        waiting = True                 # spinner up, no token yet
        self._turn_interrupted = ""    # cleared per turn; set on every exit
                                       # branch that leaves the reply partial
        printer = _StreamPrinter()

        def _settle() -> None:
            """Idempotent screen hand-off: stop the spinner/live tail and
            flush the still-open block. Called from every exit branch
            BEFORE printing a notice, so the notice never lands inside a
            live region. Completed blocks were already printed into the
            scroll flow as they streamed — an abort mid-stream leaves the
            partial reply on screen with no reprint."""
            nonlocal waiting
            if waiting:
                status_spin.stop()
                waiting = False
            printer.settle()

        try:
            with self.api.chat_stream(self.history, self.session_id,
                                      request_id) as resp:
                if resp.status_code != 200:
                    _settle()
                    self._turn_interrupted = "error"
                    try:
                        detail = self.api.error_of(resp.json())
                    except ValueError:
                        detail = (resp.text or "").strip()[:300]
                    self.notice(f"✖ HTTP {resp.status_code}: {detail}", "err")
                    return ""
                for raw in resp.iter_lines():
                    if not raw:
                        continue
                    line = raw.decode("utf-8", "replace")
                    if not line.startswith("data: "):
                        continue          # SSE comments & `event:` names
                    data = line[6:]
                    if data == "[DONE]":
                        break
                    try:
                        obj = json.loads(data)
                    except json.JSONDecodeError:
                        continue
                    if obj.get("error"):
                        _settle()
                        self._turn_interrupted = "error"
                        self.notice(f"✖ {self.api.error_of(obj)}", "err")
                        break
                    # Control-char stripping lives in _StreamPrinter.feed —
                    # the single point where reply text becomes output and
                    # becomes self.text (→ history, → /save).
                    chunk = ((obj.get("choices") or [{}])[0]
                             .get("delta", {}).get("content", ""))
                    if not chunk:
                        continue
                    if waiting:            # first token: spinner down
                        status_spin.stop()
                        waiting = False
                    printer.feed(chunk)
        except KeyboardInterrupt:
            _settle()
            self._turn_interrupted = "cancelled"
            self._abort_turn(request_id)
        except requests.exceptions.ConnectionError:
            _settle()
            self._turn_interrupted = "error"
            self.notice("✖ cannot reach the agent — is it running?", "err")
        except Exception as e:                     # noqa: BLE001 — surface anything
            _settle()
            self._turn_interrupted = "error"
            self.notice(f"✖ {type(e).__name__}: {e}", "err")
        finally:
            _settle()
        return printer.text

    def _abort_turn(self, request_id: str) -> None:
        """Ctrl-C: we closed our socket, but turns are globally serialized on
        the agent — an abandoned turn would keep working AND keep the lock.
        Cancel it server-side (cooperatively) via the turn registry."""
        try:
            status, data = self.api.cancel_turn(request_id=request_id)
            if status == 200 and isinstance(data, dict) and data.get("cancelled"):
                self.notice("⛔ aborted — agent turn cancelled", "mute")
            else:
                self.notice("⛔ aborted (turn already finished)", "mute")
        except requests.RequestException:
            self.notice("⛔ aborted locally — couldn't reach the agent "
                        "to cancel; /turns to check, /cancel to retry", "mute")
        except KeyboardInterrupt:
            # An impatient SECOND Ctrl-C, landing while we post the cancel.
            # It used to escape here and unwind the whole REPL — the
            # self-inflicted double-interrupt. The turn may still hold the
            # global lock, so say so, but keep the session.
            self.notice("⛔ cancel not confirmed — the turn may still be "
                        "running; /turns to check, /cancel to retry", "mute")

    def chat_turn(self, line: str) -> None:
        self.history.append({"role": "user", "content": line})
        request_id = uuid.uuid4().hex[:16]
        console.print()
        reply = self.stream_reply(request_id)
        console.print()
        if reply:
            # BOOKKEEPING BEFORE RENDERING. Image fetches are up to 4 serial
            # round-trips with 130s timeouts, and a Ctrl-C in that window used
            # to escape chat_turn — costing the REPL, the assistant message,
            # and the turn's rateability, for a reply the agent had already
            # finished and the server had already stored.
            self.history.append({"role": "assistant", "content": reply})
            # Keep the request_id — it is the ONLY handle a 👍/👎 has on
            # this turn's trajectory (the agent stamps X-Request-ID as the
            # trajectory's req_id, which /api/feedback resolves against).
            self.turns.append({"req_id": request_id, "prompt": line[:60],
                               "interrupted": self._turn_interrupted,
                               "label": None})
            del self.turns[:-RATE_HISTORY]
            try:
                render_reply_images(self.api, reply)
            except KeyboardInterrupt:
                self.notice("⛔ image rendering skipped", "mute")
            if not self._rate_hinted and not self._turn_interrupted:
                self._rate_hinted = True     # once per session, not per reply
                console.print(Text.assemble(
                    ("  👍 ", ""), ("/good", "mute"),
                    ("   👎 ", ""), ("/bad <why>", "mute")))
                console.print()
        else:
            # Nothing came back (error / abort before the first token):
            # drop the user message so a retry doesn't double it.
            self.history.pop()

    # -- rating (human outcome labels) -------------------------------------
    def _reset_turn_refs(self) -> None:
        """Drop the rateable refs. Called wherever the conversation the
        operator is looking at stops being the one those ids belong to
        (/clear, /new, /resume, /load) — otherwise a /good would label a
        turn from a conversation they have mentally left, which is exactly
        the reused-bubble bug the web client carries a guard for."""
        self.turns.clear()
        self._rate_hinted = False

    def _rateable(self, nth: int) -> dict | None:
        """The Nth-newest rateable reply (1 = the last one), or None with a
        notice explaining why there isn't one."""
        if nth < 1:
            self.notice("✖ ^N counts back from the last reply — ^1 is newest",
                        "err")
            return None
        if len(self.turns) < nth:
            if not self.turns:
                self.notice(
                    "nothing to rate yet — ratings attach to replies this "
                    "client streamed, so a /resume'd or /load'ed history "
                    "carries none until you ask something", "mute")
            else:
                n = len(self.turns)
                self.notice(f"only {n} rateable "
                            f"{'reply' if n == 1 else 'replies'} in this "
                            f"session", "mute")
            return None
        return self.turns[-nth]

    def _post_label(self, req_id: str, signal: str,
                    note: str) -> tuple[int, Any]:
        """POST the label, retrying the races that would otherwise lose it
        silently. Labels are scarce and gate the learning stack's clocks, so
        wait here (the operator is at the prompt anyway) and report what
        actually happened rather than firing and forgetting.

        Retried: 404 (the agent records the trajectory AFTER the stream
        closes, so a thumb typed the instant a reply lands misses it), 429,
        5xx, and — the one this loop was written for — TRANSPORT failures.
        A restarting agent, the window a deploy creates, refuses the
        connection: that is requests.ConnectionError, not HTTP 503. The
        first version retried only the HTTP shapes, so it covered the less
        likely manifestation of its own motivating scenario and dropped the
        label on the more likely one (measured: 1 attempt vs 4).

        A transport failure is reported as status 0 so the caller reports it
        as a loss rather than as a code it can mistake for a server answer.
        """
        status, data = 0, {}
        for attempt in range(1 + len(RATE_RETRY_DELAYS)):
            if attempt:
                time.sleep(RATE_RETRY_DELAYS[attempt - 1])
            try:
                status, data = self.api.feedback(req_id, signal, note)
            except requests.RequestException as e:
                status, data = 0, {"error": f"{type(e).__name__}: {e}"}
            if not (status in (0, 404, 429) or status >= 500):
                break
        return status, data

    def cmd_rate(self, signal: str, rest: str) -> None:
        """/good | /bad — one human outcome label for a completed reply.

        ``rest`` is the RAW remainder of the line: an optional leading ^N
        (how many replies back) followed by a free-text note."""
        nth = 1
        if rest.startswith("^"):
            tok, _, tail = rest.partition(" ")
            try:
                nth = int(tok[1:])
            except ValueError:
                return self.notice(f"✖ '{tok}' is not ^N (e.g. /bad ^2 …)",
                                   "err")
            rest = tail.strip()
        ref = self._rateable(nth)
        if ref is None:
            return

        # A turn the agent never finished is NOT evidence about the agent.
        # Labeling a Ctrl-C'd turn FAILED teaches the verifier that a
        # human's abort was a model failure; labeling a truncated one
        # PASSED teaches it that stopping early is fine. Both are label
        # noise in a corpus where labels are scarce enough to be load-
        # bearing — refuse, and say which case it was.
        if ref["interrupted"]:
            why = ("you cancelled it" if ref["interrupted"] == "cancelled"
                   else "it errored mid-stream")
            return self.notice(
                f"✖ that turn is not rateable — {why}, so the trajectory is "
                f"truncated and a label would describe the interruption, not "
                f"the agent. Ask again and rate the finished reply.", "err")

        note = rest.strip()
        if signal == "negative" and not note and sys.stdin.isatty():
            # The reason is the part the distiller and verifier can train
            # on — a bare thumb only resolves outcome=unknown.
            try:
                note = console.input(
                    Text("  why? (enter to skip) ", style="mute")).strip()
            except EOFError:              # Ctrl-D = end of input = skip it
                console.print()
                note = ""
            except KeyboardInterrupt:
                # Ctrl-C means CANCEL, not "skip the reason" — Enter already
                # means skip. This used to record a bare 👎 anyway.
                console.print()
                return self.notice("rating cancelled — nothing recorded",
                                   "mute")

        icon = "👍" if signal == "positive" else "👎"
        if ref["label"] and ref["label"] != signal:
            self.notice(f"re-labeling (was "
                        f"{'👍' if ref['label'] == 'positive' else '👎'}) — "
                        f"last write wins", "mute")
        with console.status(Text("recording…", style="mute"), spinner="dots"):
            status, data = self._post_label(ref["req_id"], signal, note)

        # Name the turn the operator actually rated, not just its id — with
        # ^N in play "which one did that hit?" is a real question.
        which = _trim(ref["prompt"], 40) or ref["req_id"][:8]
        if status == 200 and isinstance(data, dict) and data.get("ok"):
            ref["label"] = signal
            if data.get("unchanged"):
                return self.notice(f"{icon} already labeled — unchanged",
                                   "mute")
            return self.notice(
                f"{icon} recorded · '{which}' → "
                f"{data.get('outcome') or signal}", "ok")
        tries = 1 + len(RATE_RETRY_DELAYS)
        if status == 0:
            return self.notice(
                f"✖ label NOT recorded — couldn't reach the agent in {tries} "
                f"tries: {self.api.error_of(data)}", "err")
        if status == 404:
            # After the retries this is a real miss, not a race — the label
            # is LOST. Never let that look like success.
            return self.notice(
                "✖ label NOT recorded — no trajectory matched that turn "
                "(is trajectory logging enabled on the agent?)", "err")
        self.notice(f"✖ label NOT recorded — HTTP {status}: "
                    f"{self.api.error_of(data)}", "err")

    # -- sessions ----------------------------------------------------------
    def cmd_sessions(self) -> None:
        status, data = self.api.sessions_list()
        if status != 200:
            return self.fail(status, data)
        if not data.get("enabled"):
            return self.notice("server-side sessions are disabled on the agent")
        rows = [[s["id"][:8],
                 str(s.get("message_count", "—")),
                 _ago(s.get("updated_at")),
                 _trim(s.get("title") or "(untitled)", 48)]
                for s in data.get("sessions", [])]
        if not rows:
            return self.notice("no saved sessions yet", "mute")
        _table(["id", "msgs", "updated", "title"], rows)

    def _resolve_session(self, prefix: str) -> str | None:
        """Full id, or a unique id prefix, → full id. Notices on any miss."""
        status, _ = self.api.session_get(prefix)
        if status == 200:
            return prefix
        status, data = self.api.sessions_list(limit=200)
        hits = ([s["id"] for s in data.get("sessions", [])
                 if s["id"].startswith(prefix)]
                if status == 200 and data.get("enabled") else [])
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            self.notice(f"ambiguous — matches {', '.join(h[:8] for h in hits)}")
        else:
            self.notice(f"✖ no session matching '{prefix}'", "err")
        return None

    def cmd_resume(self, prefix: str) -> None:
        sid = self._resolve_session(prefix)
        if sid is None:
            return
        status, data = self.api.session_get(sid)
        if status != 200:
            return self.fail(status, data)
        self.history = list(data.get("messages") or [])
        self._reset_turn_refs()      # a stored history carries no req_ids
        self.session_id = sid
        title = data.get("title") or "(untitled)"
        self.notice(f"resumed {sid[:8]} · {title} · "
                    f"{len(self.history)} messages", "mute")
        # Re-orient: show the tail of the conversation being resumed.
        for m in self.history[-2:]:
            who = ("❯", "you") if m.get("role") == "user" else ("👻", "ghost")
            console.print(Text.assemble("  ", who, "  ",
                                        (_trim(m.get("content"), 100), "")))

    def cmd_new(self, title: str) -> None:
        self.history.clear()
        self._reset_turn_refs()
        if title:
            try:
                status, data = self.api.session_create(title)
                if status == 201 and isinstance(data, dict) and data.get("id"):
                    self.session_id = data["id"]
                    return self.notice(
                        f"new session · {self.session_id[:8]} · {title}", "mute")
            except requests.RequestException:
                pass
            self.notice("(server session create failed — continuing locally)", "mute")
        self.session_id = uuid.uuid4().hex
        self.notice(f"new session · {self.session_id[:8]}", "mute")

    def cmd_clear(self) -> None:
        # With durable sessions, clearing ONLY the local view would be a lie:
        # the server merges the stored history back into the next turn. A
        # real context clear needs a fresh session id — the old conversation
        # stays on the server, one /resume away.
        old = self.session_id[:8]
        self.history.clear()
        self._reset_turn_refs()
        self.session_id = uuid.uuid4().hex
        self.notice(f"context cleared — new session {self.session_id[:8]} "
                    f"(/resume {old} brings the old one back)", "mute")

    # -- ops ------------------------------------------------------------------
    def cmd_health(self) -> None:
        status, data = self.api.health()
        if status != 200:
            return self.fail(status, data)
        ok, bad = ("✓", "ok"), ("✗", "err")
        rss = data.get("rss_mb")
        try:                       # a string here used to raise ValueError
            limit = float(data.get("rss_limit_mb") or 0)
        except (TypeError, ValueError):
            limit = 0.0
        rss_s = f"{rss} MB" + (f" / {limit:.0f} MB" if limit else "")
        rows: list[tuple[str, Any]] = [
            ("status", data.get("status", "?")),
            ("uptime", _dur(data.get("uptime_s"))),
            ("memory (rss)", rss_s),
            ("asyncio tasks", data.get("asyncio_tasks")),
            ("foreground reqs", data.get("foreground_requests")),
            ("bio watchdog", ok if data.get("biological_watchdog_alive") else bad),
            ("memory system", ok if data.get("memory_system_loaded") else bad),
            ("scheduler jobs", data.get("scheduler_jobs")),
        ]
        for pool, urls in (data.get("nodes") or {}).items():
            if urls:
                rows.append((f"node {pool}", ", ".join(urls)))
        for key, val in rows:
            line = Text.assemble(("  "), (f"{key:<16}", "mute"))
            line.append_text(Text.assemble(val) if isinstance(val, tuple)
                             else Text(_safe(val)))
            console.print(line)

    def cmd_turns(self) -> None:
        status, data = self.api.turns()
        if status != 200:
            return self.fail(status, data)
        turns = data.get("turns", [])
        if not turns:
            return self.notice("no turns in flight", "mute")
        rows = [[t.get("request_id", "?")[:16],
                 "running" if t.get("running") else "queued",
                 _dur(t.get("age_s")),
                 _trim(t.get("preview"), 50)]
                for t in turns]
        _table(["request", "state", "age", "preview"], rows)

    def cmd_cancel(self, hard: bool) -> None:
        status, data = self.api.cancel_turn(hard=hard)
        if status == 200 and isinstance(data, dict) and data.get("cancelled"):
            mode = "hard-cancelled" if hard else "cancelled (cooperative)"
            self.notice(f"⛔ turn {mode}", "mute")
        elif status == 404:
            self.notice("nothing to cancel — no turn running", "mute")
        else:
            self.fail(status, data)

    def cmd_notify(self) -> None:
        status, data = self.api.notifications(NOTIFY_CONSUMER)
        if status != 200:
            return self.fail(status, data)
        if not data.get("enabled"):
            return self.notice("autonomous-activity notifications are disabled")
        records = data.get("records", [])
        watermark = data.get("watermark", 0)
        if data.get("baseline"):
            self.api.notifications_ack(NOTIFY_CONSUMER, watermark)
            return self.notice("notification feed baselined — new agent "
                               "activity will show up here from now on", "mute")
        if not records:
            return self.notice("no new notifications", "mute")
        for r in records:
            sev = str(r.get("severity", ""))
            sev_style = "err" if sev in ("error", "critical") else "notice"
            console.print(Text.assemble(
                "  ", (f"{_ago(r.get('ts')):>8}", "mute"), "  ",
                (f"{_safe(r.get('phase') or '?'):<14}", sev_style),
                (_trim(r.get("summary"), 90), "")))
        # Ack AFTER displaying — a crash mid-print re-serves them next time.
        self.api.notifications_ack(NOTIFY_CONSUMER, watermark)
        self.notice(f"({len(records)} notification(s) acknowledged)", "mute")

    def cmd_memory(self, sub: str, args: list[str]) -> None:
        if sub == "fix" and len(args) == 2:
            status, data = self.api.memory_correct(args[0], args[1])
        elif sub == "rm" and len(args) == 1:
            status, data = self.api.memory_delete(args[0])
        else:
            return self.notice(
                'usage: /memory fix "<match>" "<replacement>"  ·  '
                '/memory rm "<match>"')
        if status == 200 and isinstance(data, dict) and data.get("ok"):
            detail = json.dumps({k: v for k, v in data.items() if k != "ok"})
            self.notice(f"✓ memory updated: {detail}", "ok")
        else:
            self.fail(status, data)

    # -- files / workspace -------------------------------------------------------
    def cmd_upload(self, arg: str) -> None:
        path = Path(arg).expanduser()
        if not path.is_file():
            return self.notice(f"✖ not a file: {path}", "err")
        with console.status(Text(f"uploading {path.name}…", style="mute"),
                            spinner="dots"):
            status, data = self.api.upload(path)
        if status == 200:
            self.notice(f"✓ {data.get('filename', path.name)} → agent sandbox", "ok")
        else:
            self.fail(status, data)

    def cmd_download(self, name: str, dest_arg: str) -> None:
        dest = Path(dest_arg).expanduser() if dest_arg else Path(Path(name).name)
        if dest.is_dir():
            dest = dest / Path(name).name
        with console.status(Text(f"downloading {name}…", style="mute"),
                            spinner="dots"):
            status, size = self.api.download(name, dest)
        if status == 200:
            self.notice(f"✓ {dest} ({size:,} bytes)", "ok")
            # A downloaded image is worth a look right here.
            if dest.suffix.lower() in _IMG_EXTS and size <= _IMG_MAX_BYTES:
                try:
                    render_image_bytes(dest.name, dest.read_bytes())
                except OSError:
                    pass
        else:
            # NO unlink here. The writer never opened dest on a non-200, so
            # this "cleanup" deleted whatever local file happened to share
            # the name — the operator's own report.pdf, verified.
            self.notice(f"✖ HTTP {status} — no such file in the sandbox? "
                        f"({dest} was left alone)", "err")

    def cmd_save(self, arg: str) -> None:
        dest = (Path(arg).expanduser() if arg
                else Path(time.strftime("workspace_%Y%m%d-%H%M%S.zip")))
        with console.status(Text("packing workspace…", style="mute"),
                            spinner="dots"):
            status, size = self.api.workspace_save(self.history, dest)
        if status == 200:
            self.notice(f"✓ workspace saved → {dest} ({size:,} bytes)", "ok")
        else:
            # Same as /download: dest was never opened, so unlinking it here
            # destroyed an unrelated pre-existing file of that name.
            self.notice(f"✖ HTTP {status} — workspace save failed "
                        f"({dest} was left alone)", "err")

    def cmd_load(self, arg: str) -> None:
        path = Path(arg).expanduser()
        if not path.is_file():
            return self.notice(f"✖ not a file: {path}", "err")
        self.notice("this REPLACES the agent's sandbox and scratchpad "
                    "with the archive's contents")
        if not Confirm.ask("proceed?", default=False, console=console):
            return self.notice("cancelled", "mute")
        with console.status(Text("restoring workspace…", style="mute"),
                            spinner="dots"):
            status, data = self.api.workspace_load(path)
        if status == 200:
            restored = data.get("chat_history") or []
            if restored:
                self.history = list(restored)
                self._reset_turn_refs()   # restored turns carry no req_ids
            self.notice(f"✓ workspace restored ({len(restored)} chat messages)", "ok")
        else:
            self.fail(status, data)

    # -- projects -----------------------------------------------------------------
    def _resolve_project(self, prefix: str) -> str | None:
        status, data = self.api.projects_list()
        if status != 200:
            self.fail(status, data)
            return None
        ids = [p.get("id", "") for p in data.get("projects", [])]
        if prefix in ids:
            return prefix
        hits = [i for i in ids if i.lower().startswith(prefix.lower())]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            self.notice(f"ambiguous — matches {', '.join(hits)}")
        else:
            self.notice(f"✖ no project matching '{prefix}'", "err")
        return None

    def cmd_projects(self) -> None:
        status, data = self.api.projects_list()
        if status != 200:
            return self.fail(status, data)
        projects = data.get("projects", [])
        if not projects:
            return self.notice("no projects yet — /project new \"title\"", "mute")
        current = data.get("current")
        rows = [[("▸" if p.get("id") == current else " "),
                 str(p.get("id", "?")),
                 str(p.get("status", "?")),
                 str(p.get("kind", "")),
                 _trim(p.get("title"), 44)]
                for p in projects]
        _table([" ", "id", "status", "kind", "title"], rows)

    def cmd_project(self, sub: str, args: list[str]) -> None:
        if sub == "new":
            if not args:
                return self.notice('usage: /project new "title" ["goal"]')
            status, data = self.api.project_create(
                args[0], args[1] if len(args) > 1 else "")
            if status == 201:
                self.notice(f"✓ project created · {data.get('id')}", "ok")
            else:
                self.fail(status, data)
            return

        if not args:
            return self.notice(f"usage: /project {sub} <id>")
        pid = self._resolve_project(args[0])
        if pid is None:
            return

        if sub == "info":
            status, data = self.api.project_get(pid)
            if status != 200:
                return self.fail(status, data)
            for key in ("id", "title", "kind", "status", "goal"):
                if data.get(key):
                    console.print(Text.assemble(
                        "  ", (f"{key:<10}", "mute"),
                        (_trim(data[key], 100), "")))
            if data.get("updated_at"):
                console.print(Text.assemble(
                    "  ", (f"{'updated':<10}", "mute"),
                    (_ago(data["updated_at"]), "")))
        elif sub in ("use", "resume"):
            call = (self.api.project_switch if sub == "use"
                    else self.api.project_resume)
            status, data = call(pid)
            if status != 200:
                return self.fail(status, data)
            self.notice(f"✓ active project → {pid}", "ok")
            briefing = (data or {}).get("briefing")
            if briefing:
                console.print(Text(_safe(briefing), style="mute"))
        elif sub == "advance":
            with console.status(Text(f"advancing {pid}…", style="mute"),
                                spinner="dots"):
                status, data = self.api.project_advance(pid)
            if status != 200:
                return self.fail(status, data)
            mark = ("✓", "ok") if data.get("ok") else ("✗", "err")
            console.print(Text.assemble(
                "  ", mark, f" {data.get('classification', '?')} · "
                f"task {data.get('task_id', '—')}"))
            if data.get("summary"):
                console.print(Text(f"  {_trim(data['summary'], 400)}"))
        elif sub == "tasks":
            status, data = self.api.project_tasks(pid)
            if status != 200:
                return self.fail(status, data)
            tasks = data.get("tasks", [])
            if not tasks:
                return self.notice("no tasks in this project", "mute")
            icons = {"DONE": ("✓", "ok"), "FAILED": ("✗", "err"),
                     "IN_PROGRESS": ("▸", "notice"), "BLOCKED": ("⊘", "err")}
            for t in tasks:
                st = str(t.get("status", "")).upper()
                console.print(Text.assemble(
                    "  ", icons.get(st, ("·", "mute")), " ",
                    (f"{_safe(t.get('id'))[:8]}", "mute"), " ",
                    (_trim(t.get("description"), 76), "")))
        else:
            self.notice(f"unknown subcommand '/project {sub}' — see /help")

    # -- dispatch -------------------------------------------------------------
    def dispatch(self, line: str) -> bool:
        """Handle one input line. Returns False when the REPL should exit."""
        lowered = line.lower()
        if lowered in ("/exit", "/quit", "/bye", "exit", "quit"):
            return False
        if not line.startswith("/"):
            self.chat_turn(line)
            return True

        try:
            # Rating is parsed off the RAW line, BEFORE shlex: a failure
            # reason is free text and `/bad it didn't find the file` would
            # die in shlex.split with "No closing quotation" — losing the
            # label to a quoting rule the operator never opted into.
            head, _, rest = line.partition(" ")
            signal = RATE_CMDS.get(head.lower())
            if signal:
                self.cmd_rate(signal, rest.strip())
                return True

            try:
                parts = shlex.split(line)
            except ValueError as e:
                self.notice(f"✖ {e} — quote arguments like "
                            f"/memory fix \"a\" \"b\"", "err")
                return True
            if not parts:
                return True
            cmd, args = parts[0].lower(), parts[1:]

            match cmd:
                case "/help":
                    console.print(HELP)
                case "/clear":
                    self.cmd_clear()
                case "/new":
                    self.cmd_new(" ".join(args))
                case "/sessions" if args[:1] == ["rm"] and len(args) == 2:
                    sid = self._resolve_session(args[1])
                    if sid:
                        status, data = self.api.session_delete(sid)
                        if status == 200:
                            self.notice(f"✓ session {sid[:8]} deleted", "mute")
                        else:
                            self.fail(status, data)
                case "/sessions" if not args:
                    self.cmd_sessions()
                case "/resume" if len(args) == 1:
                    self.cmd_resume(args[0])
                case "/health":
                    self.cmd_health()
                case "/turns":
                    self.cmd_turns()
                case "/cancel":
                    self.cmd_cancel(hard=args[:1] == ["hard"])
                case "/notify":
                    self.cmd_notify()
                case "/memory" if args:
                    self.cmd_memory(args[0].lower(), args[1:])
                case "/upload" if args:
                    self.cmd_upload(" ".join(args))
                case "/download" if len(args) in (1, 2):
                    self.cmd_download(args[0], args[1] if len(args) == 2 else "")
                case "/save":
                    self.cmd_save(" ".join(args))
                case "/load" if args:
                    self.cmd_load(" ".join(args))
                case "/projects":
                    self.cmd_projects()
                case "/project" if args:
                    self.cmd_project(args[0].lower(), args[1:])
                case _:
                    self.notice(f"unknown or incomplete command '{line}' — "
                                f"see /help (plain text talks to the agent)")
        except requests.RequestException as e:
            self.notice(f"✖ {type(e).__name__}: cannot reach the agent", "err")
        except Exception as e:      # noqa: BLE001 — one bad payload, not one
            # dead session. This caught only RequestException, so a single
            # unexpected response shape ended the REPL and took the local
            # history and the rateable turn refs with it (verified: a
            # session row missing "id" → KeyError; rss_limit_mb as a string
            # → ValueError). A command may fail; the session may not.
            self.notice(f"✖ {type(e).__name__}: {e} — command failed, "
                        f"session intact", "err")
        return True

    # -- main loop -------------------------------------------------------
    def chat(self) -> None:
        self.prompt_session = PromptSession(
            key_bindings=bindings,
            style=PROMPT_STYLE,
            completer=COMPLETER,
            history=FileHistory(str(HISTORY_FILE)),
            auto_suggest=AutoSuggestFromHistory(),
            # prompt_toolkit reserves EIGHT rows for the completion menu by
            # default, for the whole session, whether or not a menu is
            # showing. That is the permanent blank gap under the prompt —
            # and because those rows are a scrolling redraw region, every
            # frame leaves the prompt character behind in scrollback, which
            # smears a block glyph into a continuous vertical bar down the
            # left of the transcript (operator screenshot, 2026-08-27).
            # Reserve nothing and complete like a shell instead: Tab lists,
            # which is what the banner has always promised.
            reserve_space_for_menu=0,
            complete_style=CompleteStyle.READLINE_LIKE,
            complete_while_typing=False,
        )
        self.banner()
        while True:
            try:
                line = self.prompt_session.prompt([("class:p", PROMPT_GLYPH)])
            except EOFError:
                break
            except KeyboardInterrupt:
                # Ctrl-C clears the line; Ctrl-D exits. These shared a
                # `break`, so the key /help advertises as "aborts a reply"
                # also ended the session when used to drop a mistyped line.
                continue
            if line is None:                        # Ctrl-D
                break
            line = line.strip()
            if not line:
                continue
            try:
                if not self.dispatch(line):
                    break
            except KeyboardInterrupt:
                # Last line of defence for an interrupt raised somewhere a
                # command didn't expect one. Individual paths handle their
                # own (see _abort_turn, chat_turn's image render).
                console.print(Text("⛔ interrupted", style="mute"))
        console.print(Text("👋 disconnected", style="dim"))


# --- one-shot (scripting) mode ---------------------------------------------

def one_shot(api: GhostAPI, prompt: str, session_id: str | None) -> int:
    """Send one message and stream the reply to stdout — rendered Markdown
    when stdout is a terminal, raw text when piped (script-friendly).
    With --session the server merges the stored history in, so this can
    continue a real conversation from a shell script."""
    body: dict[str, Any] = {"messages": [{"role": "user", "content": prompt}],
                            "stream": True}
    if session_id:
        body["session_id"] = session_id
    render = sys.stdout.isatty()
    printer = _StreamPrinter()
    # Kept in a name (it used to be inlined into the header dict) so the
    # Ctrl-C path below can cancel THIS turn server-side.
    request_id = uuid.uuid4().hex[:16]

    def _finish() -> None:
        """Flush the still-open block. Reached from the normal path AND
        from ``finally`` (idempotent), so an abort/error mid-stream still
        leaves the partial reply visible — completed blocks already flowed
        into the scroll as they streamed."""
        printer.settle()

    try:
        with api.http.post(api._url("/v1/chat/completions"), json=body,
                           headers={"X-Request-ID": request_id},
                           stream=True, timeout=(10, None)) as resp:
            if resp.status_code != 200:
                try:
                    detail = api.error_of(resp.json())
                except ValueError:
                    detail = (resp.text or "").strip()[:300]
                print(f"ghost: HTTP {resp.status_code}: {detail}", file=sys.stderr)
                return 1
            got_error = False
            for raw in resp.iter_lines():
                if not raw:
                    continue
                line = raw.decode("utf-8", "replace")
                if not line.startswith("data: "):
                    continue
                data = line[6:]
                if data == "[DONE]":
                    break
                try:
                    obj = json.loads(data)
                except json.JSONDecodeError:
                    continue
                if obj.get("error"):
                    print(f"ghost: {api.error_of(obj)}", file=sys.stderr)
                    got_error = True
                    break
                # Sanitized HERE, not in feed(): the piped branch below
                # bypasses the printer entirely, and `ghost -p q | less -R`
                # is still a terminal on the other end.
                chunk = _safe((obj.get("choices") or [{}])[0]
                              .get("delta", {}).get("content", ""))
                if not chunk:
                    continue
                if render:
                    printer.feed(chunk)
                else:
                    sys.stdout.write(chunk)
                    sys.stdout.flush()
            _finish()
            if not render:
                sys.stdout.write("\n")
            elif printer.text:
                render_reply_images(api, printer.text)
            return 1 if got_error else 0
    except KeyboardInterrupt:
        # Turns are globally SERIALIZED on the agent: an abandoned one-shot
        # keeps working and keeps the lock, wedging every other client. The
        # REPL has always cancelled server-side; this path did not, so a
        # Ctrl-C'd script blocked the agent until the turn finished on its
        # own. Same cancel, same request id.
        _finish()
        try:
            status, data = api.cancel_turn(request_id=request_id)
            cancelled = (status == 200 and isinstance(data, dict)
                         and data.get("cancelled"))
            print("ghost: aborted — agent turn cancelled" if cancelled
                  else "ghost: aborted (turn already finished)",
                  file=sys.stderr)
        except (requests.RequestException, KeyboardInterrupt):
            print("ghost: aborted locally — could not reach the agent to "
                  "cancel; the turn may still hold the lock", file=sys.stderr)
        return 130
    except requests.RequestException as e:
        print(f"ghost: {type(e).__name__}: cannot reach the agent", file=sys.stderr)
        return 1
    finally:
        _finish()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Ghost Agent CLI — chat, sessions, files, projects, ops.")
    parser.add_argument("--url", default=DEFAULT_HOST, help="Agent URL")
    parser.add_argument("--key", default=DEFAULT_KEY, help="API key (X-Ghost-Key)")
    parser.add_argument("-p", "--prompt", metavar="TEXT",
                        help="one-shot: send TEXT ('-' reads stdin), print reply, exit")
    parser.add_argument("--session", metavar="ID",
                        help="server-side session id to resume / continue")
    parser.add_argument("--health", action="store_true",
                        help="print agent health and exit")
    args = parser.parse_args()

    api = GhostAPI(args.url, args.key)

    if args.health:
        cli = GhostCLI(api)
        try:
            cli.cmd_health()
        except requests.RequestException as e:
            print(f"ghost: {type(e).__name__}: cannot reach the agent",
                  file=sys.stderr)
            return 1
        return 0

    prompt = args.prompt
    if prompt is None and not sys.stdin.isatty():
        prompt = sys.stdin.read()          # `echo q | ghost` == `ghost -p -`
    if prompt is not None:
        if prompt == "-":
            prompt = sys.stdin.read()
        prompt = prompt.strip()
        if not prompt:
            print("ghost: empty prompt", file=sys.stderr)
            return 1
        return one_shot(api, prompt, args.session)

    cli = GhostCLI(api, session_id=args.session)
    if args.session:
        try:
            cli.cmd_resume(args.session)
        except requests.RequestException:
            cli.notice("(couldn't resume that session — starting fresh)", "mute")
    cli.chat()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        sys.exit(130)
