class GhostAPI:
    """Thin typed wrapper over the agent's HTTP surface."""

    def __init__(self, base_url: str, api_key: str):
        # Reduce to scheme://host:port — request paths are appended, so a
        # stray path/query on base_url would build a malformed URL (→ 405).
        raw = str(base_url or "").strip()
        p = urlparse(raw)
        if p.scheme not in ("http", "https") or not p.netloc:
            # GHOST_URL=eva:8000 parses as scheme='eva', netloc='' — it fell
            # through to the raw string and every call then died with a bare
            # MissingSchema instead of just working. Assume http.
            p = urlparse("http://" + raw.split("://", 1)[-1])
        self.base_url = (f"{p.scheme}://{p.netloc}" if p.netloc
                         else raw.rstrip("/"))
        self.http = requests.Session()
        self.http.headers["X-Ghost-Key"] = api_key

    @staticmethod
    def _stream_to_file(resp: requests.Response, dest: Path) -> int:
        """Stream a 200 body into ``dest`` via a sibling temp file and one
        atomic rename. ``dest`` is not touched unless the WHOLE body
        arrived, and the only thing ever unlinked is our own temp file.

        Both halves were bugs. A transfer that died mid-stream left a
        truncated file over the operator's original; and the callers
        "cleaned up" a failure with dest.unlink(), which deleted a
        PRE-EXISTING local file the CLI had never written — verified:
        `/download report.pdf` against a 404 removed the operator's own
        report.pdf."""
        tmp = dest.with_name(f".{dest.name}.part-{uuid.uuid4().hex[:8]}")
        written = 0
        try:
            with tmp.open("wb") as fh:
                for chunk in resp.iter_content(65536):
                    fh.write(chunk)
                    written += len(chunk)
            os.replace(tmp, dest)
        except BaseException:      # KeyboardInterrupt included, deliberately
            tmp.unlink(missing_ok=True)
            raise
        return written

    def _url(self, path: str) -> str:
        return f"{self.base_url}{path}"

    def _json(self, method: str, path: str, *, body: dict | None = None,
              params: dict | None = None, files: dict | None = None,
              timeout: tuple = (10, 60)) -> tuple[int, Any]:
        """One JSON round-trip → (status_code, parsed body). Non-JSON bodies
        come back as {'raw': text} so callers never need a second parse."""
        r = self.http.request(method, self._url(path), json=body,
                              params=params, files=files, timeout=timeout)
        try:
            return r.status_code, r.json()
        except ValueError:
            return r.status_code, {"raw": (r.text or "").strip()[:300]}

    @staticmethod
    def error_of(data: Any) -> str:
        """Human message out of any of the agent's error shapes:
        {'error': {'message': ...}} / {'error': str} / {'detail': ...} / raw."""
        if isinstance(data, dict):
            err = data.get("error")
            if isinstance(err, dict):
                return str(err.get("message") or err)
            if err:
                return str(err)
            return str(data.get("detail") or data.get("raw") or data)
        return str(data)

    # -- chat --------------------------------------------------------------
    def chat_stream(self, messages: list[dict], session_id: str,
                    request_id: str, effort: str = "") -> requests.Response:
        headers = {"X-Request-ID": request_id}
        if effort:                                  # §4RB: Default sends nothing
            headers["X-Ghost-Effort"] = effort
        return self.http.post(
            self._url("/v1/chat/completions"),
            json={"messages": messages, "stream": True,
                  "session_id": session_id},
            headers=headers,
            stream=True, timeout=(10, None),   # connect 10s; agent ends the read
        )

    # -- sessions ------------------------------------------------------------
    def sessions_list(self, limit: int = 50) -> tuple[int, Any]:
        return self._json("GET", "/api/sessions", params={"limit": limit})

    def session_get(self, sid: str) -> tuple[int, Any]:
        return self._json("GET", f"/api/sessions/{quote(sid, safe='')}")

    def session_create(self, title: str = "") -> tuple[int, Any]:
        return self._json("POST", "/api/sessions", body={"title": title})

    def session_delete(self, sid: str) -> tuple[int, Any]:
        return self._json("DELETE", f"/api/sessions/{quote(sid, safe='')}")

    # -- turns / ops -----------------------------------------------------------
    def turns(self) -> tuple[int, Any]:
        return self._json("GET", "/api/turns")

    def cancel_turn(self, request_id: str | None = None,
                    hard: bool = False, timeout: tuple = (10, 60)) -> tuple[int, Any]:
        return self._json("POST", "/api/turn/cancel",
                          body={"request_id": request_id, "hard": hard},
                          timeout=timeout)

    # -- §4RZ queued messages (a message sent while a turn runs) -------------
    def turn_inbox(self, session_id: str, text: str) -> tuple[int, Any]:
        """A message typed while this conversation's turn runs → ``{"path":
        "inject"|"cancel"|"status"|"queue", ...}`` (the agent routes it)."""
        return self._json("POST", "/api/turn/inbox",
                          body={"session_id": session_id, "text": text},
                          timeout=INBOX_TIMEOUT)

    def turn_interrupt(self, session_id: str) -> tuple[int, Any]:
        """Stop the tool(s) the turn is running; the turn goes on. 200 /
        404 (no running turn for this sender, or the feature is off) / 409
        (no tool running)."""
        return self._json("POST", "/api/turn/interrupt",
                          body={"session_id": session_id},
                          timeout=INBOX_TIMEOUT)

    def inbox_leftovers(self, session_id: str) -> tuple[int, Any]:
        """Messages a turn accepted but never read → ``{"messages": [...]}``;
        the client sends them as normal messages."""
        return self._json("POST", "/api/turn/inbox/leftovers",
                          body={"session_id": session_id},
                          timeout=LEFTOVERS_TIMEOUT)

    def feedback(self, request_id: str, signal: str, note: str = "",
                 source: str = FEEDBACK_SOURCE) -> tuple[int, Any]:
        """Human outcome label for one completed turn. ``signal`` is
        'positive'|'negative'; ``note`` on a negative becomes the
        trajectory's failure_reason (the agent caps it at 500 chars and
        redacts it before logging — cap here too so the wire matches)."""
        return self._json("POST", "/api/feedback",
                          body={"request_id": request_id, "signal": signal,
                                "note": note[:500], "source": source},
                          timeout=RATE_TIMEOUT)

    def health(self, timeout: tuple = (10, 30)) -> tuple[int, Any]:
        return self._json("GET", "/api/health", timeout=timeout)

    def notifications(self, consumer: str, limit: int = 50) -> tuple[int, Any]:
        return self._json("GET", "/api/notifications/pending",
                          params={"consumer": consumer, "limit": limit})

    def notifications_ack(self, consumer: str, watermark: int) -> tuple[int, Any]:
        return self._json("POST", "/api/notifications/ack",
                          body={"consumer": consumer, "watermark": watermark})

    def memory_correct(self, match: str, replacement: str) -> tuple[int, Any]:
        return self._json("POST", "/api/memory/correct",
                          body={"match": match, "replacement": replacement})

    def memory_delete(self, match: str) -> tuple[int, Any]:
        return self._json("POST", "/api/memory/delete", body={"match": match})

    # -- files / workspace ------------------------------------------------------
    def upload(self, path: Path) -> tuple[int, Any]:
        with path.open("rb") as fh:
            return self._json("POST", "/api/upload",
                              files={"file": (path.name, fh)},
                              timeout=(10, 600))

    def download(self, name: str, dest: Path) -> tuple[int, int]:
        """Stream a sandbox file to ``dest``. Returns (status, bytes_written).
        A non-200 leaves ``dest`` untouched — see _stream_to_file."""
        with self.http.get(self._url(f"/api/download/{quote(name)}"),
                           stream=True, timeout=(10, 600)) as r:
            if r.status_code != 200:
                return r.status_code, 0
            return 200, self._stream_to_file(r, dest)

    def workspace_save(self, history: list[dict], dest: Path) -> tuple[int, int]:
        with self.http.post(self._url("/api/workspace/save"),
                            json={"chat_history": history},
                            stream=True, timeout=(10, 600)) as r:
            if r.status_code != 200:
                return r.status_code, 0
            return 200, self._stream_to_file(r, dest)

    def workspace_load(self, path: Path) -> tuple[int, Any]:
        with path.open("rb") as fh:
            return self._json("POST", "/api/workspace/load",
                              files={"file": (path.name, fh)},
                              timeout=(10, 600))

    # -- projects ---------------------------------------------------------------
    def projects_list(self) -> tuple[int, Any]:
        return self._json("GET", "/api/projects")

    def project_get(self, pid: str) -> tuple[int, Any]:
        return self._json("GET", f"/api/projects/{quote(pid, safe='')}")

    def project_create(self, title: str, goal: str = "") -> tuple[int, Any]:
        return self._json("POST", "/api/projects",
                          body={"title": title, "goal": goal})

    def project_switch(self, pid: str) -> tuple[int, Any]:
        return self._json("POST", f"/api/projects/{quote(pid, safe='')}/switch")

    def project_resume(self, pid: str) -> tuple[int, Any]:
        return self._json("POST", f"/api/projects/{quote(pid, safe='')}/resume")

    def project_advance(self, pid: str) -> tuple[int, Any]:
        # An advance runs a full agent task — allow it to take its time.
        return self._json("POST", f"/api/projects/{quote(pid, safe='')}/advance",
                          timeout=(10, 900))

    def project_tasks(self, pid: str) -> tuple[int, Any]:
        return self._json("GET", f"/api/projects/{quote(pid, safe='')}/tasks")


class GhostCLI:
    def __init__(self, api: GhostAPI, session_id: str | None = None):
        self.api = api
        self.history: list[dict] = []
        # Durable server-side session: the agent persists every turn under
        # this id (created lazily on first append), so any client can resume
        # it later. Must match the server's ^[A-Za-z0-9_-]{1,64}$ rule.
        self.session_id = session_id or uuid.uuid4().hex
        # Built lazily in chat(): constructing a PromptSession on a non-tty
        # stdin (e.g. `ghost --health` from a script) warns on stderr.
        self.prompt_session: PromptSession | None = None
        # Rateable replies, oldest → newest — one ref per reply THIS client
        # streamed. A /resume'd or /load'ed history carries no request ids,
        # so it contributes none (see _reset_turn_refs).
        self.turns: list[dict] = []
        self._rate_hinted = False
        # Set by stream_reply: "" | "cancelled" | "error". A turn the agent
        # never finished is not rateable — see cmd_rate.
        self._turn_interrupted = ""
        # §4RB: reasoning effort for this client's turns ("" = Default), and
        # whether the agent's switch is on (set by the banner's health probe).
        self.effort = ""
        self._effort_switch = False
        self._effort_default = ""      # the server's own level (health), for Default's icon
        # The pinned status line's liveness segment, refreshed off-thread
        # (see _start_status_refresh) so drawing it never waits on the network.
        self._probe_cache: Text | None = None
        # Token counter (2026-10-27): the last turn's totals, from the
        # agent's `ghost.usage` frame (None until one arrives). Reset with
        # the turn refs.
        self.turn_usage: dict | None = None
        # §4RZ 6b — messages typed while a turn runs. _held: this turn's
        # messages the inbox did not take (queued path, feature off, network
        # error); _outbox: what the REPL sends, in order, before its next
        # prompt (leftovers, then the held ones). The next prompt starts with
        # _restored (messages a stop handed back, oldest first) and then
        # _draft (what the operator was typing) — see _take_draft.
        self._held: list[str] = []
        self._outbox: collections.deque[str] = collections.deque()
        self._restored: list[str] = []
        self._draft = ""
        # This turn's lines in typing order, and those the inbox accepted
        # (inject) — see _abort_turn / _after_busy_turn.
        self._typed: list[str] = []
        self._injected: list[str] = []
        # This turn's ACCEPTED typings not yet back in the prompt, in typing
        # order: (text, accepted by an EARLIER turn). Server lists are matched
        # onto these one for one; nothing else is ever deduplicated (r10).
        self._open: list[tuple[str, bool]] = []
        # Leftovers the agent handed out and the line a turn is sending are
        # kept HERE, never only in a local, until the restore or send that
        # consumes them has committed (review r12): see _salvage.
        self._fresh: list[str] = []
        self._sending: tuple[str, dict, bool] | None = None
        # The busy turn's ONE deferring SIGINT handler box (review r12).
        self._sig: dict | None = None
        self._streamed = {"any": False, "refused": False}
        self._turn_clean = False
        self._turn_stopped = False
        self._busy_session: PromptSession | None = None

    # -- presentation ----------------------------------------------------
    def banner(self) -> None:
        """The start-up hint under a rule that spans the window. The status
        line (identity, effort, endpoint, session, liveness) is no longer
        printed here: it is pinned under the prompt (2026-10-24, operator) —
        see status_toolbar.

        The old banner hardcoded a 52-column rule and unconditionally
        assembled the full URL, the session id and 'up 3h 20m' — so it
        under-ran a wide terminal and WRAPPED in a narrow one, which is
        what the operator saw first, every time."""
        console.print()
        console.print(_rule())
        console.print(self._hint_line(console.width))
        console.print()

    def status_toolbar(self) -> ANSI:
        """The pinned status line under the prompt — _banner_line rendered to
        ANSI for prompt_toolkit. Called on every redraw, so it never touches
        the network: liveness comes from the background probe's cache, the
        effort level straight from self.effort (a /effort shows at once)."""
        width = shutil.get_terminal_size((80, 24)).columns
        probe = self._probe_cache or Text("○ checking…", style="faint")
        buf = io.StringIO()
        Console(file=buf, force_terminal=True, color_system="truecolor",
                width=width + 10, theme=THEME, highlight=False,
                ).print(self._banner_line(width, probe), end="")
        return ANSI(buf.getvalue())

    def _start_status_refresh(self) -> None:
        """Probe health now and every STATUS_REFRESH_S on a daemon thread,
        redrawing the prompt when the answer lands. The thread gets its OWN
        requests.Session — one Session shared with a streaming turn is not
        thread-safe."""
        api = copy.copy(self.api)
        api.http = requests.Session()
        api.http.headers.update(self.api.http.headers)
        prober = copy.copy(self)
        prober.api = api

        def _loop() -> None:
            while True:
                text = prober._probe()
                self._effort_switch = prober._effort_switch
                self._effort_default = prober._effort_default
                self._probe_cache = text
                app = self.prompt_session.app if self.prompt_session else None
                if app is not None and app.is_running:
                    app.invalidate()
                time.sleep(STATUS_REFRESH_S)

        threading.Thread(target=_loop, name="ghost-status", daemon=True).start()

    def _banner_line(self, width: int, probe_text: Text | None = None) -> Text:
        """Identity and liveness are never what gets cut; the session id,
        the endpoint and the effort level are, in that order, as the window
        narrows. Effort shows only while the agent's switch is on (the
        probe's health answer says) — off, a level means nothing."""
        host = self.api.base_url.split("://", 1)[-1]
        sep = ("  ·  ", "faint")
        probe = Text("  ·  ", style="faint")
        probe.append_text(self._probe() if probe_text is None else probe_text)
        optional = [[sep, (host, "mute")],
                    [sep, (self.session_id[:8], "faint")]]
        tokens = self._token_segment()
        if tokens:
            optional.insert(0, [sep] + tokens)
        if self._effort_switch:
            icon = EFFORT_ICONS.get(self.effort or self._effort_default, "")
            optional.insert(0, [sep, ("effort ", "faint")]
                            + ([(icon + " ", "")] if icon else [])
                            + [(EFFORT_LABELS[self.effort].lower(),
                                "you" if self.effort else "mute")])
        return _fit_line(
            head=[("  👻 ghost", "bold ghost")],
            optional=optional, tail=probe, width=width)

    def _token_segment(self) -> list:
        """``↑31.2k (28.0k cached) ↓840`` — the last turn's context and
        generation tokens, summed over every model call it made (operator
        10-27: "just up and down, for context / generation"). ``~`` marks a
        turn with a call that ended without its usage report (its context
        tokens are missing). A turn that reported nothing shows nothing —
        never the previous turn's numbers (r1 m3)."""
        u = self.turn_usage
        if not u:
            return []
        approx = "~" if u["approx"] else ""
        parts = [(f"↑{approx}{_tok(u['prompt'])}", "mute")]
        if u["cached"]:
            parts.append((f" ({_tok(u['cached'])} cached)", "faint"))
        parts.append((f" ↓{_tok(u['completion'])}", "mute"))
        return parts

    def _hint_line(self, width: int) -> Text:
        return _fit_line(
            head=[("  /help", "you")],
            optional=[[("  ·  Tab completes", "faint")],
                      [("  ·  ", "faint"), ("Ctrl-D", "mute"),
                       (" exits", "faint")]],
            width=width)

    def _probe(self) -> Text:
        """One cheap health ping for the banner: reachability + key check."""
        try:
            status, data = self.api.health(timeout=(2, 5))
        except requests.RequestException:
            return Text("○ unreachable", style="err")
        if status == 200:
            self._effort_switch = (isinstance(data, dict)
                                   and data.get("reasoning_effort") is True)
            self._effort_default = str((data or {}).get("reasoning_effort_default") or "") \
                if isinstance(data, dict) else ""
            # Compact ("3h20m", not "up 3h 20m") — this is the segment the
            # banner can least afford to spend width on.
            up = _dur(data.get("uptime_s")).replace(" ", "")
            return Text.assemble(("● online", "ok"), (f" {up}", "faint"))
        if status == 403:
            return Text("● key rejected", style="err")
        return Text(f"● HTTP {status}", style="notice")

    @staticmethod
    def notice(msg: str, style: str = "notice") -> None:
        # Text() keeps the message literal — never parsed as rich markup
        # (error details / titles can contain anything, including brackets).
        # _safe() additionally strips ESC/C1: server error prose reaches here
        # verbatim, and rich does not strip escape introducers.
        # Indented to the gutter so notices share the transcript's left edge
        # with replies and tables.
        console.print(Text(" " * GUTTER + _safe(msg), style=style))

    def fail(self, status: int, data: Any) -> None:
        self.notice(f"✖ HTTP {status}: {self.api.error_of(data)}", "err")

    # -- chat turn ---------------------------------------------------------
    def stream_reply(self, request_id: str, busy: _BusyView | None = None) -> str:
        """POST the history and render the streamed reply live as Markdown.
        Returns its text (possibly partial, if aborted) so the caller can
        keep context.

        ``busy`` (§4RZ 6b): this runs on the stream thread under the busy
        prompt — the spinner and the open block go to the prompt's message,
        and a stop from the prompt mutes everything this prints."""
        if busy is None:
            status_spin = console.status(Text("thinking…", style="faint"),
                                         spinner="dots")
            note, new_printer = self.notice, _StreamPrinter
        else:
            status_spin, note, new_printer = busy.spinner, busy.note, busy.new_printer
        status_spin.start()
        waiting = True                 # spinner up, no token yet
        self._turn_interrupted = ""    # cleared per turn; set on every exit
                                       # branch that leaves the reply partial
        self._turn_unlabelable = False  # §4ML: the agent said "no trajectory"
        self.turn_usage = None         # this turn's frame, or nothing (r1 m3)
        printer = new_printer()
        held = None                    # §4KP: a list while the reply is held
        saw_done = False               # the stream's own terminal frame arrived
        saw_retract = False            # a hard stop's shape: retract, then no reply

        def _release() -> None:
            nonlocal held, waiting
            if held is None:
                return
            text, held = strip_orphan_think_close("".join(held)), None
            if text:
                if waiting:
                    status_spin.stop()
                    waiting = False
                printer.feed(text)

        def _settle() -> None:
            """Idempotent screen hand-off: stop the spinner/live tail and
            flush the still-open block. Called from every exit branch
            BEFORE printing a notice, so the notice never lands inside a
            live region. Completed blocks were already printed into the
            scroll flow as they streamed — an abort mid-stream leaves the
            partial reply on screen with no reprint."""
            nonlocal waiting
            if waiting:
                status_spin.stop()
                waiting = False
            printer.settle()

        try:
            with self.api.chat_stream(self.history, self.session_id,
                                      request_id, self.effort) as resp:
                if busy is not None:
                    busy.resp = resp
                if resp.status_code != 200:
                    _settle()
                    self._streamed["refused"] = True
                    self._turn_interrupted = "error"
                    try:
                        detail = self.api.error_of(resp.json())
                    except ValueError:
                        detail = (resp.text or "").strip()[:300]
                    note(f"✖ HTTP {resp.status_code}: {detail}", "err")
                    return ""
                for raw in resp.iter_lines():
                    if busy is not None and busy.detached:
                        break             # stopped from the busy prompt
                    if not raw:
                        continue
                    line = raw.decode("utf-8", "replace")
                    if not line.startswith("data: "):
                        continue          # SSE comments & `event:` names
                    data = line[6:]
                    if data == "[DONE]":
                        saw_done = True
                        break
                    try:
                        obj = json.loads(data)
                    except json.JSONDecodeError:
                        continue
                    if (set(obj.get("ghost") or {}) - {"usage", "labelable"}
                            or (obj.get("choices") or [{}])[0].get("delta", {}).get("content")):
                        self._streamed["any"] = True   # the turn ran (r16)
                    if obj.get("error"):
                        _settle()
                        self._turn_interrupted = "error"
                        note(f"✖ {self.api.error_of(obj)}", "err")
                        break
                    # Control-char stripping lives in _StreamPrinter.feed —
                    # the single point where reply text becomes output and
                    # becomes self.text (→ history, → /save).
                    if (obj.get("ghost") or {}).get("labelable") is False:
                        self._turn_unlabelable = True
                    _usage = (obj.get("ghost") or {}).get("usage")
                    if isinstance(_usage, dict):
                        self._note_usage(_usage)
                        continue
                    if (obj.get("ghost") or {}).get("retract") is True:
                        # §4MP: the agent dropped the text it streamed (a tool
                        # call followed, or the reply was rewritten). Printed
                        # lines cannot be taken back: mark it, start again.
                        saw_retract = True
                        if held is not None:
                            held.clear()
                        elif printer.text:
                            printer.settle()
                            note("↺ revised — the reply continues below", "mute")
                            printer = new_printer()
                        continue
                    if (obj.get("ghost") or {}).get("reasoning_unparsed") is True and held is None:
                        held = []
                    chunk = ((obj.get("choices") or [{}])[0]
                             .get("delta", {}).get("content", ""))
                    if not chunk:
                        continue
                    if held is not None:
                        held.append(chunk)
                        continue
                    if waiting:            # first token: spinner down
                        status_spin.stop()
                        waiting = False
                    printer.feed(chunk)
        except KeyboardInterrupt:
            _settle()
            self._turn_interrupted = "cancelled"
            self._abort_turn(request_id)
        except requests.exceptions.ConnectionError:
            _settle()
            self._turn_interrupted = "error"
            note("✖ cannot reach the agent — is it running?", "err")
        except Exception as e:                     # noqa: BLE001 — surface anything
            _settle()
            self._turn_interrupted = "error"
            note(f"✖ {type(e).__name__}: {e}", "err")
        finally:
            if self._turn_interrupted or not saw_done:
                held = None            # §4KP: never the unfiltered reasoning of a cut reply
            _release()
            _settle()
        # §4RZ r3: stopped on the agent (by another client, or /cancel) — the
        # stream ends normally; only the reply says so. Read by the busy
        # prompt's after-turn step alone (nothing else changes on this flag).
        # A clean reply with no text (tool- or image-only) is NOT a stop: only
        # a retract followed by no reply is (review r4).
        self._turn_stopped = bool(
            saw_done and not self._turn_interrupted
            and ((saw_retract and not printer.text.strip())
                 or _STOPPED_NOTE_RE.search(printer.text.rstrip())))
        # POSITIVE evidence the turn ended normally (operator rule, r5): the
        # stream's own end, a non-empty reply, no stop signal. Only then is
        # anything sent on its own after the reply.
        self._turn_clean = bool(saw_done and not self._turn_interrupted
                                and printer.text.strip() and not self._turn_stopped)
        return printer.text

    def _note_usage(self, usage: dict) -> None:
        """The agent's turn totals (one frame, just before [DONE]),
        normalised here so a redraw never parses (r1 n6)."""
        def num(key: str) -> int:
            try:
                return max(0, int(usage.get(key) or 0))
            except (TypeError, ValueError, OverflowError):
                return 0
        u = {"prompt": num("prompt_tokens"), "completion": num("completion_tokens"),
             "cached": num("cached_tokens"), "approx": num("unmetered_calls") > 0}
        u["cached"] = min(u["cached"], u["prompt"])
        self.turn_usage = u

    def _abort_turn(self, request_id: str, *, timeout: tuple | None = None,
                    restore: bool = False, started: bool = True) -> None:
        """Ctrl-C: we closed our socket, but turns are globally serialized on
        the agent — an abandoned turn would keep working AND keep the lock.
        Cancel it server-side (cooperatively) via the turn registry.

        ``restore`` (busy prompt only): messages the turn accepted and never
        read come back into the prompt. The classic path keeps the old
        behaviour exactly: it never posts to the inbox, so anything there
        came from ANOTHER client on this session and is not this prompt's.

        ``started`` False: nothing had streamed yet, so a "no such turn"
        answer may mean the agent had not registered it yet (review r15)."""
        answer: tuple | None = None
        # Each step of answered() runs once (r16): a KeyboardInterrupt that
        # lands inside it re-enters it from the except branch.
        done = {"said": False, "back": False}

        def answered() -> None:
            if self._sig is not None:
                self._sig["raise"] = False  # answered: the wait is over (r14)
            status, data = answer
            if status == 200 and isinstance(data, dict) and data.get("cancelled"):
                if not done["said"]:
                    self.notice("⛔ aborted — agent turn cancelled", "mute")
                    done["said"] = True
                if restore and not done["back"]:
                    # restore-first, booked on the same line; then claim
                    back = self._restore_to_prompt(data.get("undelivered")); done["back"] = True  # noqa: E702
                    self._claim(back)
            elif done["said"]:
                return
            elif not started:
                self.notice("⛔ the agent had no running turn to cancel — it may "
                            "not have registered it yet and may still run it; "
                            "/turns to check before resending", "mute")
            else:
                self.notice("⛔ aborted (turn already finished)", "mute")
            done["said"] = True

        try:
            kw = {"timeout": timeout} if timeout else {}
            answer = self.api.cancel_turn(request_id=request_id, **kw)
            answered()
        except requests.RequestException as e:
            if restore and _never_sent(e):
                # Never reached the agent: the turn runs on, and what it
                # accepted it still reads, or hands back as leftovers.
                self.notice("⛔ aborted locally — couldn't reach the agent, so "
                            "the turn was NOT cancelled; /turns to check, "
                            "/cancel to retry", "mute")
            elif restore:
                self.notice("⛔ the agent did not answer the cancel — the turn "
                            "may or may not be cancelled; /turns to check, "
                            "/cancel to retry", "mute")
                self._restore_unknown()
            else:
                self.notice("⛔ aborted locally — couldn't reach the agent "
                            "to cancel; /turns to check, /cancel to retry", "mute")
        except KeyboardInterrupt:
            # An impatient SECOND Ctrl-C, landing while we post the cancel.
            # It used to escape here and unwind the whole REPL — the
            # self-inflicted double-interrupt. The turn may still hold the
            # global lock, so say so, but keep the session.
            if answer is not None:          # the answer is in hand: use it (r15)
                answered()
                return
            self.notice("⛔ cancel not confirmed — the turn may still be "
                        "running; /turns to check, /cancel to retry", "mute")
            if restore:
                self._restore_unknown()

    def _restore_unknown(self, earlier_only: bool = False) -> None:
        """Accepted typings that no answer accounted for (a lost or empty
        cancel answer — another client's cancel may have emptied the inbox
        into ITS answer — or an earlier turn this client cannot see end):
        the CLI cannot tell which were read. Name them all and put them back
        (review r3: lost silently). ``earlier_only``: only those accepted by
        an earlier turn (review r10)."""
        texts = [t for t, e in self._open if e or not earlier_only]
        texts = self._restore_to_prompt(texts)   # first: an interrupt can't lose them
        self._open = [(t, e) for t, e in self._open if earlier_only and not e]
        if not texts:
            return
        names = "; ".join(f"«{_trim(t, 50)}»" for t in texts)
        self.notice(f"sent during the turn — the agent may or may not have read "
                    f"{'them' if len(texts) > 1 else 'it'}; back in the prompt: "
                    f"{names}", "notice")

    def _hand_back(self, texts: Any) -> None:
        """A server list straight into the prompt: restored FIRST, then
        claimed, so an interrupt in between costs at most a duplicate, never
        a text (review r11 nit)."""
        self._claim(self._restore_to_prompt(texts))

    def _claim_one(self, text: str) -> bool:
        """Mark the first open accepted typing with this text as back."""
        for i, (t, _) in enumerate(self._open):
            if t == text:
                del self._open[i]
                return True
        return False

    def _claim(self, texts: Any) -> list[str]:
        """A server list (undelivered, leftovers): matched one for one onto
        this turn's accepted typings, which are then back. EVERY text is
        returned to be restored, matched or not — a duplicate is acceptable,
        a loss is not (review r10: another client's identical "ok")."""
        texts = [str(t) for t in (texts or []) if str(t).strip()]
        for t in texts:
            self._claim_one(t)
        return texts

    def _in_typing_order(self, items: list[str]) -> list[str]:
        """This turn's items sorted by when they were typed; a text typed
        twice gets each occurrence's own index (review r4). Items not typed
        this turn (another client's, an earlier turn's) come first."""
        slots: dict[str, list[int]] = {}
        for i, t in enumerate(self._typed):
            slots.setdefault(t, []).append(i)
        keyed = [(slots[t].pop(0) if slots.get(t) else -1, n, t)
                 for n, t in enumerate(items)]
        return [t for _, _, t in sorted(keyed)]

    # -- §4RZ 6b: typing while a turn runs --------------------------------
    def _busy_enabled(self) -> bool:
        """The busy prompt runs only in the interactive REPL on a terminal.
        GHOST_CLI_BUSY_PROMPT=0 restores the classic path (the reply streams
        on the main thread, nothing can be typed until it ends)."""
        if os.environ.get("GHOST_CLI_BUSY_PROMPT", "1").strip() == "0":
            return False
        return (self.prompt_session is not None and sys.stdin.isatty()
                and console.is_terminal)

    def _busy_stdout(self) -> Any:
        return patch_stdout(raw=True)

    def _turn_api(self) -> GhostAPI:
        """The stream thread's own client: one requests.Session shared with
        the main thread's inbox posts is not thread-safe."""
        api = copy.copy(self.api)
        api.http = requests.Session()
        api.http.headers.update(self.api.http.headers)
        return api

    def _busy_prompt(self, view: _BusyView, draft: str) -> Any:
        """One busy-prompt read → the typed line, None (Ctrl-D, ignored),
        _Ended (the turn ended) or _Abort (Ctrl-C)."""
        if self._busy_session is None:
            kb = KeyBindings()

            @kb.add("c-c")
            @kb.add("<sigint>")             # a SIGINT in a cooked-mode window
            def _(event):                   # Ctrl-C → stop the turn (r13: same
                event.app.exit(result=_Abort(event.app.current_buffer.text))  # path)

            @kb.add("c-d")
            def _(event):                   # Ctrl-D mid-turn: not an exit
                pass

            hist = self.prompt_session.history if self.prompt_session else None
            self._busy_session = PromptSession(
                key_bindings=merge_key_bindings([bindings, kb]),
                style=PROMPT_STYLE, completer=COMPLETER, history=hist,
                auto_suggest=AutoSuggestFromHistory(),
                reserve_space_for_menu=0,
                complete_style=CompleteStyle.READLINE_LIKE,
                complete_while_typing=False,
                bottom_toolbar=self.status_toolbar,
                refresh_interval=BUSY_REFRESH_S,
                # The frame holds the live tail: erased on exit, or every
                # Enter would leave a copy of the tail in scrollback.
                erase_when_done=True,
                placeholder=[(f"fg:{PALETTE['faint']}",
                              "type to add to this request · /interrupt stops "
                              "a tool · Ctrl-C stops the turn")],
            )
            # Every chunk invalidates, and each redraw renders the open block
            # (a table with no blank line IS the whole reply): cap it at rich
            # Live's 12/s, the clock _LazyMarkdown was measured against.
            self._busy_session.app.min_redraw_interval = 1 / 12
        view.app = self._busy_session.app
        view.app.ghost_busy_owner = view    # see _BusyView.exit_if_done
        return self._busy_session.prompt(view.message, default=draft,
                                         pre_run=view.exit_if_done)

    def _hold(self, text: str, why: str = "") -> None:
        # A stop/hold word typed this turn (``_typed`` includes this line)
        # also holds back every line typed after it: sent ahead of it, they
        # would undo the "wait" (review r6).
        if any(_is_hold_word(t) for t in self._typed) or _is_hold_word(text):
            self._restore_to_prompt([text])
            self.notice(f"not sent: {_trim(text, 60)} — the turn did not take it"
                        + (f" ({why})" if why else "") + ", and after a stop or "
                        "a hold nothing is sent on its own; it is back in the "
                        "prompt after the reply", "dim")
            return
        self._held.append(text)
        self.notice(f"held: {_trim(text, 60)} — sent after this reply"
                    + (f" ({why})" if why else ""), "dim")

    def _restore_to_prompt(self, texts: Any) -> list[str]:
        """Unsent messages go back into the next prompt, oldest first, in
        front of whatever draft is already there. Returns what was added.
        No deduplication here: an accepted typing comes back once because
        it leaves ``_open`` when restored (_claim, _restore_unknown)."""
        added = [str(t) for t in (texts or []) if str(t).strip()]
        self._restored.extend(added)
        return added

    def _take_draft(self, keep: bool = False) -> str:
        """The next prompt's starting text (and clear it): handed-back
        messages first, oldest first, then the operator's own draft.
        ``keep``: leave them on self — the busy prompt commits them only
        once the prompt is done with them (review r12)."""
        if self._restored:                  # said once, where they reappear
            n = len(self._restored)
            self.notice(f"{n} unsent message{'s' if n != 1 else ''} "
                        f"back in the prompt", "mute")
        parts = self._restored + ([self._draft] if self._draft else [])
        if not keep:
            self._restored, self._draft = [], ""
        return "\n".join(parts)

    @contextlib.contextmanager
    def _sigint_deferred(self, escalate: bool = False):
        """ONE deferring SIGINT handler for the whole busy turn (review r12):
        the outermost call — chat_turn's — installs it, so a Ctrl-C never
        raises anywhere in the turn; it is counted (``n``, ``hit``) and the
        stream loop and the settle read it at their decision points: a stop.
        A nested call only opens a scope on the same box:
        ``escalate`` — a blocking network wait (an inbox post, the
        leftovers take) that a SECOND Ctrl-C inside it gives up (raises);
        ``box["raise"] = True`` — a wait any Ctrl-C ends (the stop's join
        and cancel). Off the main thread (signals can only be handled
        there) it defers nothing."""
        import signal
        box = self._sig
        if box is not None:                 # nested: a scope, not a handler
            prev = box["esc"]
            if escalate:
                box["esc"] = box["n"]
            try:
                yield box
            finally:
                box["esc"] = prev
            return
        box = {"hit": False, "n": 0, "raise": False,
               "esc": 0 if escalate else None}

        def _note(signum, frame):
            box["n"] += 1
            box["hit"] = True
            if box["raise"] or (box["esc"] is not None
                                and box["n"] - box["esc"] >= 2):
                raise KeyboardInterrupt

        try:
            old = signal.signal(signal.SIGINT, _note)
        except ValueError:                  # not the main thread
            yield box
            return
        self._sig = box
        try:
            yield box
        finally:
            self._sig = None
            signal.signal(signal.SIGINT, old)

    def _busy_line(self, line: str, sig: dict | None = None,
                   rid: str = "") -> tuple[str, Any]:
        """Route one line typed while the turn runs → (action, payload):
        ("", None) handled · ("draft", text) back into the prompt ·
        ("cancel", undelivered) the inbox stopped the turn."""
        if line.startswith("/"):
            if line.split()[0].lower() == "/interrupt":
                self.cmd_interrupt()
                return "", None
            # Commands change the conversation the turn is answering
            # (/clear, /resume, /good…): they wait for the reply.
            self.notice("commands run after the reply — it is back in the "
                        "prompt", "mute")
            return "draft", line
        self._typed.append(line)
        # Only the POST itself may be given up by a second Ctrl-C (``sig``,
        # from the caller's deferral): once its answer is in, the line is
        # booked (held / injected / put back) with Ctrl-C held, so it can
        # never be booked AND put back by the caller (review r3 nit a).
        if sig is not None:
            sig["esc"] = sig["n"]           # this POST: a 2nd Ctrl-C gives up
        try:
            status, data = self.api.turn_inbox(self.session_id, line)
        except requests.RequestException as e:
            if sig is not None:
                sig["esc"] = None
            if _never_sent(e):
                self._hold(line, "couldn't reach the agent")
            else:
                # It may have been delivered (and read by the turn): never
                # sent again on its own — back into the prompt instead.
                self._restore_to_prompt([line])
                self.notice(f"the agent did not answer — it may have received "
                            f"this; it is back in the prompt after the reply: "
                            f"{_trim(line, 60)}", "dim")
            return "", None
        if sig is not None:
            sig["esc"] = None
        if status == 404 or (status == 200 and isinstance(data, dict)
                              and data.get("path") == "queue"
                              and str(data.get("reason") or "").startswith(
                                  "queued messages are off")):
            # No inbox (the feature is off, or an older agent): the old CLI
            # never sent anything typed mid-turn, and a "stop" or "wait"
            # sent as a fresh request after the reply means something else.
            # It comes back into the prompt for the operator to send.
            self._restore_to_prompt([line])
            self.notice(f"kept: {_trim(line, 60)} — the agent takes no "
                        f"messages mid-turn (queued messages are off); it is "
                        f"back in the prompt after the reply", "dim")
            return "", None
        if status != 200 or not isinstance(data, dict):
            self._hold(line, f"HTTP {status}")
            return "", None
        path = data.get("path")
        other = str(data.get("request_id") or "")
        own = re.sub(r"#\d+\Z", "", other)    # register() renames a reused id
        if rid and other and not own.endswith(rid) and path in ("inject", "status", "cancel"):
            # The agent routes by conversation to its latest RUNNING turn: an
            # earlier turn still finishing while this one waits on the lock
            # (review r6). The answer is not about this turn.
            if path == "cancel":
                # The stop word is echoed and this turn cancelled (never put
                # back: Enter would send "stop" as a message). The earlier
                # turn's unread lines are named; one already sent as a
                # message here or in the turn before is dropped (r7).
                sent = [ln for m in self.history[-3:] if m.get("role") == "user"
                        for ln in str(m.get("content") or "").split("\n")]
                unread = []
                for t in data.get("undelivered") or []:
                    if self._claim_one(str(t)) or t in self._typed:
                        unread.append(str(t))   # typed HERE: never dropped (r9)
                    elif t in sent:
                        sent.remove(t)          # one-for-one
                    elif str(t).strip():
                        unread.append(str(t))
                self.notice(f"that stop reached an earlier turn still finishing "
                            f"({_safe(other)[:8]}) — stopping this turn as well", "mute")
                unread = self._restore_to_prompt(unread)
                if unread:
                    self.notice("the earlier turn's unread messages, back in the "
                                "prompt: " + ", ".join(f"«{_trim(t, 60)}»"
                                                       for t in unread), "dim")
                return "stop-own", line
            if path == "inject":            # accepted: never offered twice
                # ...unless that turn's end is not seen from here (r10).
                self._open.append((line, True))
                self.notice(f"the earlier turn ({_safe(other)[:8]}), still "
                            f"finishing, received it and may act on it: "
                            f"{_trim(line, 60)}", "dim")
                return "", None
            self._restore_to_prompt([line])
            self.notice(f"that was answered by an earlier turn still finishing "
                        f"({_safe(other)[:8]}), not this one — back in the prompt "
                        f"after the reply: {_trim(line, 60)}", "dim")
            return "", None
        if path == "inject":
            self._injected.append(line)
            self._open.append((line, False))
            self.notice(f"queued: {_trim(line, 200)}", "dim")
        elif path == "status":
            console.print(Text.assemble(
                (" " * GUTTER + PROMPT_GLYPH, "you"), (_trim(line, 200), "")))
            self.notice(f"↳ {_safe(data.get('reply') or '(no status)')}", "mute")
        elif path == "cancel":                # echoed after the partial reply
            return "cancel", (line, list(data.get("undelivered") or []))
        else:                               # "queue", or a path we don't know
            self._hold(line, _safe(data.get("reason") or ""))
        return "", None

    def _stream_busy(self, request_id: str) -> str:
        """The reply streams on a thread; the main thread keeps a live
        prompt (see _BusyView). Returns the reply text, like stream_reply."""
        view = _BusyView()
        # Per-turn state was reset by chat_turn BEFORE anything could escape
        # (_reset_turn) — and before this copy: the worker must never start
        # from the last turn's verdict (review r6).
        worker = copy.copy(self)            # turn state lands on the copy
        worker.api = self._turn_api()
        box: dict[str, Any] = {}

        def _run() -> None:
            try:
                box["reply"] = worker.stream_reply(request_id, busy=view)
            except BaseException as e:      # noqa: BLE001 — reported below
                box["error"] = e
            finally:
                view.finish()

        thread = threading.Thread(target=_run, name="ghost-stream", daemon=True)
        # The draft stays on self until the prompt is done with it (r12).
        shown = len(self._restored)
        draft = self._take_draft(keep=True)
        stop: tuple[str, Any] | None = None
        # chat_turn's ONE deferring handler (a stand-in off the main thread).
        sig = self._sig or {"hit": False, "n": 0, "raise": False, "esc": None}
        with self._busy_stdout():
            if sig["hit"]:
                # A Ctrl-C counted before the request left (r13): it never
                # goes — chat_turn's _unsend puts the line back.
                return ""
            thread.start(); self._sending = None  # noqa: E702 — sent: one line, no gap
            while not view.done.is_set():
                inflight = ""                   # a typed line not yet handled
                if sig["hit"]:                  # a Ctrl-C between prompts
                    stop = ("ctrl-c", None)
                    break
                try:
                    res = self._busy_prompt(view, draft)
                    draft = ""
                    if isinstance(res, _Abort):
                        draft, stop = res.text, ("ctrl-c", None)
                        break
                    if isinstance(res, _Ended):
                        draft = res.text
                        if view.done.is_set():
                            break
                        continue        # never another turn's end (defensive)
                    if res is None or not res.strip():
                        continue
                    inflight = res.strip()
                    # Ctrl-C during the post is held until it answers, so
                    # the line is never lost (it was delivered, held, or is
                    # put back), and then it stops the turn. A SECOND Ctrl-C
                    # gives up the wait (the line goes back to the prompt).
                    try:
                        action, payload = self._busy_line(inflight, self._sig,
                                                          request_id)
                    finally:
                        if self._sig is not None:
                            self._sig["esc"] = None  # the scope ends here
                    inflight = ""
                    if action == "draft":
                        draft = payload
                    if action == "cancel":
                        stop = ("inbox", payload)
                        break
                    if action == "stop-own":
                        stop = ("own", payload)     # cancel THIS turn by its id
                        break
                    if sig["hit"]:
                        stop = ("ctrl-c", None)
                        break
                except (KeyboardInterrupt, EOFError):
                    # Ctrl-C outside the prompt's raw mode (around an inbox
                    # post), or stdin closed mid-turn: the same stop — the
                    # turn must not keep running on the agent. A line typed
                    # but not handled goes back into the prompt.
                    if inflight:
                        self._restore_to_prompt([inflight])
                    stop = ("ctrl-c", None)
                    break
            # Commit in ONE statement: what was shown is the prompt's now.
            self._restored, self._draft = self._restored[shown:], draft
            if stop is None:
                while thread.is_alive() and not sig["hit"]:
                    thread.join(0.2)        # a Ctrl-C is counted, not raised
                if thread.is_alive():
                    stop = ("ctrl-c", None)
            if stop is None:
                self._turn_interrupted = worker._turn_interrupted
                self._turn_unlabelable = getattr(worker, "_turn_unlabelable", False)
                self._turn_stopped = getattr(worker, "_turn_stopped", False)
                # Anything that escaped stream_reply means the turn did not
                # end normally, whatever the worker had set.
                self._turn_clean = ("error" not in box
                                    and getattr(worker, "_turn_clean", False))
                self.turn_usage = worker.turn_usage
                if "error" in box:
                    self.notice(f"✖ {type(box['error']).__name__}: "
                                f"{box['error']}", "err")
                return box.get("reply", "")
            # Stopped from the prompt: the Ctrl-C path. Mute the worker,
            # wake it, keep what streamed so far. A second Ctrl-C here is
            # held: the cancel on the agent must always be sent.
            # A Ctrl-C here is counted by the turn's handler; "raise" opens
            # the waits it may end (the join, the cancel).
            text, rest = view.detach()  # held: never left half-done
            sig["raise"] = True         # from here a Ctrl-C ends a WAIT
            try:
                thread.join(STOP_JOIN_S)
            except KeyboardInterrupt:
                pass                    # stop waiting; the cancel still goes
            finally:
                sig["raise"] = False    # never left set past its wait (r13)
            if rest.strip():
                console.print(_reply_block(rest))
            self._turn_interrupted = "cancelled"
            self._turn_unlabelable = False
            self.turn_usage = None
            if stop[0] in ("ctrl-c", "own"):
                if stop[0] == "own":    # the stop word, echoed once
                    console.print(Text.assemble(
                        (" " * GUTTER + PROMPT_GLYPH, "you"),
                        (_trim(stop[1], 200), "")))
                sig["raise"] = True     # _abort_turn: "cancel not confirmed"
                try:
                    self._abort_turn(request_id, timeout=CANCEL_TIMEOUT,
                                     restore=True,
                                     started=self._streamed["any"])
                except KeyboardInterrupt:   # landed outside its try
                    sig["raise"] = False    # the wait is over: count again
                    self.notice("⛔ cancel not confirmed — the turn may still "
                                "be running; /turns to check, /cancel to retry",
                                "mute")
                    self._restore_unknown()
                finally:
                    sig["raise"] = False    # never left set past its wait (r13)
            else:                       # the inbox already stopped it
                said, undelivered = stop[1]
                console.print(Text.assemble(
                    (" " * GUTTER + PROMPT_GLYPH, "you"), (_trim(said, 200), "")))
                self.notice("⛔ stopped — agent turn cancelled", "mute")
                self._hand_back(undelivered)
            return text

    def _after_busy_turn(self, escaped: bool = False, asked: bool = True) -> None:
        """Leftovers (accepted, never read) and held messages: sent as
        normal messages after a finished reply; after a stopped one they go
        back into the prompt instead — the operator said stop.

        ``escaped``: the turn's own code was left by an exception (a Ctrl-C
        right as the reply ended): an unclean end (review r11). ``asked``
        False: no request left, so there is no turn to ask leftovers of —
        no POST, no notice about it (r14); the rest settles as unclean.

        Runs inside chat_turn's deferring handler; everything it works on
        stays on self (_held, _fresh, _open) until the restore that consumes
        it has committed, so chat_turn's _salvage finds it should anything
        escape (review r12)."""
        gave_up = unreachable = answered = False
        status, data = 0, None
        # The agent hands leftovers out once, so an answer cut off would lose
        # them; a second Ctrl-C gives up the wait (esc) only during the POST.
        with self._sigint_deferred(escalate=True) as sig:
            try:
                if asked:
                    status, data = self.api.inbox_leftovers(self.session_id)
                else:
                    status = None
            except requests.RequestException as e:
                unreachable = _never_sent(e)
                gave_up = not unreachable
            except KeyboardInterrupt:       # a second Ctrl-C: stop waiting
                gave_up = True
            sig["esc"] = None               # the answer is in: book it whole
            if status == 200 and isinstance(data, dict):
                answered = True             # only this counts (review r6)
                # RULE (r4): a leftover — accepted by the agent but read by
                # no turn — is NEVER sent on its own; it goes back into the
                # prompt, named. Kept on self at once; matched FIRST, so the
                # accepted typing it is does not come back twice.
                self._fresh = [str(m) for m in (data.get("messages") or [])
                               if str(m).strip()]
                self._claim(self._fresh)
            self._settle(sig, escaped, answered, gave_up, unreachable, status)

    def _settle(self, sig: dict, escaped: bool, answered: bool, gave_up: bool,
                unreachable: bool, status: int | None) -> None:
        """_after_busy_turn's decision, with Ctrl-C held by the caller.
        Reads _held / _fresh / _open on self and clears them only after the
        statement that puts them in the prompt or the outbox (review r12)."""
        fresh, held = list(self._fresh), list(self._held)
        if unreachable:
            # Leftovers are kept per conversation: honest about where they
            # can come back (review r3: /new, /clear, /resume leave them).
            self.notice("couldn't fetch messages sent during the turn (agent "
                        "unreachable) — the agent keeps them for 30 min, and "
                        "they come back only after a later reply in THIS "
                        "conversation", "mute")
        if gave_up:
            # The agent hands leftovers out as it answers: an answer that
            # never arrived may have taken them. Never silent.
            self.notice("messages sent during the turn may not have been read "
                        "— the agent did not answer; see /turns", "notice")
        elif not answered and not unreachable and status is not None:
            self.notice(f"messages sent during the turn may not have been read "
                        f"— the agent answered HTTP {status}; see /turns", "notice")
        # RULE (operator, review r5): sending anything on its own needs
        # POSITIVE evidence — the turn ended normally with a non-empty reply
        # and no stop signal. Any other ending (an empty reply, with or
        # without a retract — a hard stop of a turn that streamed nothing
        # sends only [DONE]; a stop seen here or elsewhere; an error; a lost
        # stream; a Ctrl-C or a lost answer just now) puts back everything
        # typed during the turn that is not known to be read.
        clean = self._turn_clean and not sig["hit"] and answered and not escaped
        if self._turn_stopped:
            self.notice("the turn was stopped on the agent — nothing typed "
                        "during it is sent on its own", "mute")
        elif (not clean and not self._turn_interrupted and answered
              and not sig["hit"] and (held or self._injected or self._outbox)):
            self.notice("the turn ended without a reply — nothing typed during "
                        "it is sent on its own", "mute")
        # Every accepted typing no answer accounted for is named and put
        # back. Even an answered cancel proves nothing: another client's
        # cancel may have emptied the inbox into ITS answer (review r6). A
        # line the agent did read may come back ("may or may not have read").
        # After a clean end only those an EARLIER turn accepted (r10): its
        # end is not seen from here.
        self._restore_unknown(earlier_only=clean)
        if fresh:
            names = "; ".join(f"«{_trim(t, 50)}»" for t in fresh)
            self.notice(f"not read by the agent — back in the prompt: {names}",
                        "notice")
        if clean and held and any(_is_hold_word(t) for t in self._typed):
            # DECISION (r8, operator: "a stop or hold sent later means
            # something else"): a stop/hold typed this turn keeps EVERY held
            # line of the turn, before it as well as after it.
            names = "; ".join(f"«{_trim(t, 50)}»" for t in held)
            self.notice(f"not sent — a stop or hold was typed during the turn; "
                        f"back in the prompt: {names}", "notice")
            self._restored += held          # ordered with the rest below
            self._held = held = []          # consumed: in the prompt
        clean = clean and not sig["hit"]    # a Ctrl-C while settling: a stop
        if not clean:
            # Everything comes back into the prompt, in typing order: held
            # messages still waiting from earlier turns, then this turn's.
            self._restored = list(self._outbox) + self._in_typing_order(
                self._restored + fresh + held)
            self._outbox.clear()
        else:
            self._restored = self._in_typing_order(self._restored + fresh)
            self._outbox.extend(held)
        # Committed above (a gap here costs a duplicate, never a line).
        self._held, self._fresh, self._open = [], [], []

    def _reset_turn(self) -> None:
        """Per-turn state, reset at the START of the protected span, before
        anything can escape (review r12: an escape before the old reset
        put a clean turn's read lines back)."""
        self._typed, self._injected, self._open, self._fresh = [], [], [], []
        self._turn_interrupted, self._turn_stopped, self._turn_clean = "", False, False
        # Shared with the stream worker (copy.copy keeps the dict): "any"
        # once the stream delivered ANY content — text, reasoning, retract,
        # tool status (r16: the one source of truth for "started");
        # "refused" when the agent answered the chat POST with an error status.
        self._streamed = {"any": False, "refused": False}

    def _unsend(self) -> None:
        """The line chat_turn was sending never left (an escape before the
        request): out of history — else the next turn sends it as context —
        and back into the prompt, first (review r12)."""
        if self._sending is None:
            return
        line, entry, outbox = self._sending
        if self.history and self.history[-1] is entry:
            self.history.pop()
        if outbox:                          # back at the head of its queue (r13)
            self._outbox.appendleft(line); self._sending = None  # noqa: E702
        else:
            self._restored.insert(0, line); self._sending = None  # noqa: E702

    def _salvage(self) -> None:
        """An escape left the turn half-settled: everything still on self
        comes back into the prompt, named — never lost, never sent, nothing
        carried into the next turn (reviews r11, r12)."""
        self._unsend()
        salvage = [t for t, _ in self._open] + self._fresh + self._held
        self._restored = list(self._outbox) + self._in_typing_order(
            self._restored + salvage)
        self._outbox.clear()
        self._open, self._fresh, self._held = [], [], []
        if salvage:                         # restored first: a print can't lose it
            self.notice("interrupted — not sent; back in the prompt: "
                        + "; ".join(f"«{_trim(t, 50)}»" for t in salvage), "notice")

    def _send_outbox(self) -> None:
        """Send the next held message as a normal turn (from chat())."""
        text = self._outbox[0]              # popped by chat_turn, protected
        console.print(Text.assemble((PROMPT_GLYPH, "you"), (_safe(text), ""),
                                    ("   · sent after the reply", "faint")))
        self.chat_turn(text, outbox=True)

    def cmd_interrupt(self) -> None:
        """/interrupt — stop the tool this conversation's turn is running;
        the turn goes on (§4RZ step 5)."""
        try:
            status, data = self.api.turn_interrupt(self.session_id)
        except requests.RequestException as e:
            return self.notice(f"✖ {type(e).__name__}: cannot reach the agent", "err")
        data = data if isinstance(data, dict) else {}
        if status == 200:
            names = ", ".join(_safe(n) for n in (data.get("interrupted") or [])) or "the tool"
            self.notice(f"⏹ stopped {names} — the turn goes on", "mute")
        elif status == 409:
            self.notice("nothing running — no tool to stop", "mute")
        elif status == 404:
            if "off" in str(data.get("reason") or ""):
                self.notice("the agent's queued messages are off "
                            "(GHOST_QUEUED_MESSAGES) — /cancel stops the whole turn",
                            "mute")
            else:
                self.notice("no running turn in this conversation", "mute")
        else:
            self.fail(status, data)

    def chat_turn(self, line: str, outbox: bool = False) -> None:
        """One turn. ``outbox``: ``line`` is _outbox[0], popped here only
        once it sits in the _sending slot (review r12).

        Busy prompt: the WHOLE turn — from the pop and the history append
        through _after_busy_turn — runs inside ONE deferring SIGINT handler
        (review r12): a Ctrl-C there is a stop, never an exception. The
        state it moves stays on self, and _salvage puts it back should
        anything still escape. A line whose request never left is taken out
        of history and put back into the prompt (_unsend), in both modes."""
        busy = self._busy_enabled()
        if not busy:
            return self._classic_turn(line, outbox)
        with self._sigint_deferred():       # the ONE handler for the turn
            settled = False
            try:
                self._reset_turn()
                self._send_slot(line, outbox)
                request_id = uuid.uuid4().hex[:16]
                escaped = True
                try:
                    console.print()
                    reply = self._stream_busy(request_id)
                    if not reply and (self._turn_interrupted or self._turn_stopped):
                        # A stop before any reply text: _finish_turn drops the
                        # line from history, so it comes back here, named — it
                        # may or may not have reached the agent (review r15).
                        self._restored.insert(0, line)
                        self.notice(
                            f"back in the prompt — the agent did not take it: "
                            f"«{_trim(line, 60)}»" if self._streamed["refused"] else
                            f"back in the prompt — the agent may or may not have "
                            f"received it: «{_trim(line, 60)}»", "mute")
                    self._finish_turn(line, request_id, reply)
                    escaped = False
                finally:
                    left = self._sending is None    # did the request leave?
                    if not left and not escaped:    # a counted Ctrl-C (r14)
                        self.notice(f"⛔ stopped — not sent: «{_trim(line, 60)}»",
                                    "mute")
                    self._unsend()          # no-op once the request left
                    self._after_busy_turn(escaped=escaped, asked=left)
                    settled = True
            finally:
                if not settled:
                    self._salvage()

    def _send_slot(self, line: str, outbox: bool) -> None:
        """The line goes into the _sending slot and history in one step
        each: an escape after either is undone by _unsend."""
        entry = {"role": "user", "content": line}
        self._sending = (self._outbox.popleft() if outbox else line, entry, outbox)
        self.history.append(entry)

    def _classic_turn(self, line: str, outbox: bool) -> None:
        """GHOST_CLI_BUSY_PROMPT=0: the old blocking stream, Ctrl-C as
        before; only the unsent-line undo is shared (review r12)."""
        try:
            self._send_slot(line, outbox)
            request_id = uuid.uuid4().hex[:16]
            console.print()
            self._sending = None; reply = self.stream_reply(request_id)  # noqa: E702
            self._finish_turn(line, request_id, reply)
        finally:
            self._unsend()

    def _finish_turn(self, line: str, request_id: str, reply: str) -> None:
        console.print()
        if reply:
            # BOOKKEEPING FIRST: the assistant message and the turn's rateable
            # ref are recorded before anything else can be interrupted.
            self.history.append({"role": "assistant", "content": reply})
            # Keep the request_id — it is the ONLY handle a 👍/👎 has on
            # this turn's trajectory (the agent stamps X-Request-ID as the
            # trajectory's req_id, which /api/feedback resolves against).
            self.turns.append({"req_id": request_id, "prompt": line[:60],
                               "interrupted": self._turn_interrupted,
                               "unlabelable": getattr(self, "_turn_unlabelable", False),
                               "label": None})
            del self.turns[:-RATE_HISTORY]
            if (not self._rate_hinted and not self._turn_interrupted
                    and not getattr(self, "_turn_unlabelable", False)):
                self._rate_hinted = True     # once per session, not per reply
                console.print(Text.assemble(
                    ("  👍 ", ""), ("/good", "mute"),
                    ("   👎 ", ""), ("/bad <why>", "mute")))
                console.print()
        else:
            # Nothing came back (error / abort before the first token):
            # drop the user message so a retry doesn't double it.
            self.history.pop()

    # -- rating (human outcome labels) -------------------------------------
    def _reset_turn_refs(self) -> None:
        """Drop the rateable refs. Called wherever the conversation the
        operator is looking at stops being the one those ids belong to
        (/clear, /new, /resume, /load) — otherwise a /good would label a
        turn from a conversation they have mentally left, which is exactly
        the reused-bubble bug the web client carries a guard for."""
        self.turns.clear()
        self._rate_hinted = False
        # The token counter belongs to the same conversation.
        self.turn_usage = None

    def _rateable(self, nth: int) -> dict | None:
        """The Nth-newest rateable reply (1 = the last one), or None with a
        notice explaining why there isn't one."""
        if nth < 1:
            self.notice("✖ ^N counts back from the last reply — ^1 is newest",
                        "err")
            return None
        if len(self.turns) < nth:
            if not self.turns:
                self.notice(
                    "nothing to rate yet — ratings attach to replies this "
                    "client streamed, so a /resume'd or /load'ed history "
                    "carries none until you ask something", "mute")
            else:
                n = len(self.turns)
                self.notice(f"only {n} rateable "
                            f"{'reply' if n == 1 else 'replies'} in this "
                            f"session", "mute")
            return None
        return self.turns[-nth]

    def _post_label(self, req_id: str, signal: str,
                    note: str) -> tuple[int, Any]:
        """POST the label, retrying the races that would otherwise lose it
        silently. Labels are scarce and gate the learning stack's clocks, so
        wait here (the operator is at the prompt anyway) and report what
        actually happened rather than firing and forgetting.

        Retried: 404 (the agent records the trajectory AFTER the stream
        closes, so a thumb typed the instant a reply lands misses it), 429,
        5xx, and — the one this loop was written for — TRANSPORT failures.
        A restarting agent, the window a deploy creates, refuses the
        connection: that is requests.ConnectionError, not HTTP 503. The
        first version retried only the HTTP shapes, so it covered the less
        likely manifestation of its own motivating scenario and dropped the
        label on the more likely one (measured: 1 attempt vs 4).

        A transport failure is reported as status 0 so the caller reports it
        as a loss rather than as a code it can mistake for a server answer.
        """
        status, data = 0, {}
        for attempt in range(1 + len(RATE_RETRY_DELAYS)):
            if attempt:
                time.sleep(RATE_RETRY_DELAYS[attempt - 1])
            try:
                status, data = self.api.feedback(req_id, signal, note)
            except requests.RequestException as e:
                status, data = 0, {"error": f"{type(e).__name__}: {e}"}
            if not (status in (0, 404, 429) or status >= 500):
                break
        return status, data

    def cmd_rate(self, signal: str, rest: str) -> None:
        """/good | /bad — one human outcome label for a completed reply.

        ``rest`` is the RAW remainder of the line: an optional leading ^N
        (how many replies back) followed by a free-text note."""
        nth = 1
        if rest.startswith("^"):
            tok, _, tail = rest.partition(" ")
            try:
                nth = int(tok[1:])
            except ValueError:
                return self.notice(f"✖ '{tok}' is not ^N (e.g. /bad ^2 …)",
                                   "err")
            rest = tail.strip()
        ref = self._rateable(nth)
        if ref is None:
            return

        # A turn the agent never finished is NOT evidence about the agent.
        # Labeling a Ctrl-C'd turn FAILED teaches the verifier that a
        # human's abort was a model failure; labeling a truncated one
        # PASSED teaches it that stopping early is fine. Both are label
        # noise in a corpus where labels are scarce enough to be load-
        # bearing — refuse, and say which case it was.
        if ref.get("unlabelable"):
            # §4ML: the agent marks quick replies (a greeting) unlabelable —
            # no trajectory is recorded, so a rating retried for ~6 s and
            # then blamed trajectory logging
            return self.notice(
                "✖ that reply can't be rated — the agent records no trajectory "
                "for quick replies like greetings", "err")
        if ref["interrupted"]:
            why = ("you cancelled it" if ref["interrupted"] == "cancelled"
                   else "it errored mid-stream")
            return self.notice(
                f"✖ that turn is not rateable — {why}, so the trajectory is "
                f"truncated and a label would describe the interruption, not "
                f"the agent. Ask again and rate the finished reply.", "err")

        note = rest.strip()
        if signal == "negative" and not note and sys.stdin.isatty():
            # The reason is the part the distiller and verifier can train
            # on — a bare thumb only resolves outcome=unknown.
            try:
                note = console.input(
                    Text("  why? (enter to skip) ", style="mute")).strip()
            except EOFError:              # Ctrl-D = end of input = skip it
                console.print()
                note = ""
            except KeyboardInterrupt:
                # Ctrl-C means CANCEL, not "skip the reason" — Enter already
                # means skip. This used to record a bare 👎 anyway.
                console.print()
                return self.notice("rating cancelled — nothing recorded",
                                   "mute")

        icon = "👍" if signal == "positive" else "👎"
        if ref["label"] and ref["label"] != signal:
            self.notice(f"re-labeling (was "
                        f"{'👍' if ref['label'] == 'positive' else '👎'}) — "
                        f"last write wins", "mute")
        with console.status(Text("recording…", style="mute"), spinner="dots"):
            status, data = self._post_label(ref["req_id"], signal, note)

        # Name the turn the operator actually rated, not just its id — with
        # ^N in play "which one did that hit?" is a real question.
        which = _trim(ref["prompt"], 40) or ref["req_id"][:8]
        if status == 200 and isinstance(data, dict) and data.get("ok"):
            ref["label"] = signal
            if data.get("unchanged"):
                return self.notice(f"{icon} already labeled — unchanged",
                                   "mute")
            return self.notice(
                f"{icon} recorded · '{which}' → "
                f"{data.get('outcome') or signal}", "ok")
        tries = 1 + len(RATE_RETRY_DELAYS)
        if status == 0:
            return self.notice(
                f"✖ label NOT recorded — couldn't reach the agent in {tries} "
                f"tries: {self.api.error_of(data)}", "err")
        if status == 404:
            # After the retries this is a real miss, not a race — the label
            # is LOST. Never let that look like success.
            return self.notice(
                "✖ label NOT recorded — no trajectory matched that turn "
                "(is trajectory logging enabled on the agent?)", "err")
        self.notice(f"✖ label NOT recorded — HTTP {status}: "
                    f"{self.api.error_of(data)}", "err")

    # -- sessions ----------------------------------------------------------
    def cmd_sessions(self) -> None:
        status, data = self.api.sessions_list()
        if status != 200:
            return self.fail(status, data)
        if not data.get("enabled"):
            return self.notice("server-side sessions are disabled on the agent")
        rows = [[s["id"][:8],
                 str(s.get("message_count", "—")),
                 _ago(s.get("updated_at")),
                 _trim(s.get("title") or "(untitled)", 48)]
                for s in data.get("sessions", [])]
        if not rows:
            return self.notice("no saved sessions yet", "mute")
        _table(["id", "msgs", "updated", "title"], rows)

    def _resolve_session(self, prefix: str) -> str | None:
        """Full id, or a unique id prefix, → full id. Notices on any miss."""
        status, _ = self.api.session_get(prefix)
        if status == 200:
            return prefix
        status, data = self.api.sessions_list(limit=200)
        hits = ([s["id"] for s in data.get("sessions", [])
                 if s["id"].startswith(prefix)]
                if status == 200 and data.get("enabled") else [])
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            self.notice(f"ambiguous — matches {', '.join(h[:8] for h in hits)}")
        else:
            self.notice(f"✖ no session matching '{prefix}'", "err")
        return None

    def cmd_resume(self, prefix: str) -> None:
        sid = self._resolve_session(prefix)
        if sid is None:
            return
        status, data = self.api.session_get(sid)
        if status != 200:
            return self.fail(status, data)
        self.history = list(data.get("messages") or [])
        self._reset_turn_refs()      # a stored history carries no req_ids
        self.session_id = sid
        title = data.get("title") or "(untitled)"
        self.notice(f"resumed {sid[:8]} · {title} · "
                    f"{len(self.history)} messages", "mute")
        # Re-orient: show the tail of the conversation being resumed.
        for m in self.history[-2:]:
            who = ("❯", "you") if m.get("role") == "user" else ("👻", "ghost")
            console.print(Text.assemble("  ", who, "  ",
                                        (_trim(m.get("content"), 100), "")))

    def cmd_new(self, title: str) -> None:
        self.history.clear()
        self._reset_turn_refs()
        if title:
            try:
                status, data = self.api.session_create(title)
                if status == 201 and isinstance(data, dict) and data.get("id"):
                    self.session_id = data["id"]
                    return self.notice(
                        f"new session · {self.session_id[:8]} · {title}", "mute")
            except requests.RequestException:
                pass
            self.notice("(server session create failed — continuing locally)", "mute")
        self.session_id = uuid.uuid4().hex
        self.notice(f"new session · {self.session_id[:8]}", "mute")

    def cmd_clear(self) -> None:
        # With durable sessions, clearing ONLY the local view would be a lie:
        # the server merges the stored history back into the next turn. A
        # real context clear needs a fresh session id — the old conversation
        # stays on the server, one /resume away.
        old = self.session_id[:8]
        self.history.clear()
        self._reset_turn_refs()
        self.session_id = uuid.uuid4().hex
        # A cleared context gets a cleared screen too — the old transcript
        # left on screen read as if it were still the conversation. Only
        # on a terminal: piped output has no screen to wipe.
        if console.is_terminal:
            console.clear()
            self.banner()
        self.notice(f"context cleared — new session {self.session_id[:8]} "
                    f"(/resume {old} brings the old one back)", "mute")

    # -- ops ------------------------------------------------------------------
    def cmd_health(self) -> None:
        status, data = self.api.health()
        if status != 200:
            return self.fail(status, data)
        ok, bad = ("✓", "ok"), ("✗", "err")
        rss = data.get("rss_mb")
        try:                       # a string here used to raise ValueError
            limit = float(data.get("rss_limit_mb") or 0)
        except (TypeError, ValueError):
            limit = 0.0
        rss_s = f"{rss} MB" + (f" / {limit:.0f} MB" if limit else "")
        rows: list[tuple[str, Any]] = [
            ("status", data.get("status", "?")),
            ("uptime", _dur(data.get("uptime_s"))),
            ("memory (rss)", rss_s),
            ("asyncio tasks", data.get("asyncio_tasks")),
            ("foreground reqs", data.get("foreground_requests")),
            ("idle scheduler", ok if data.get("biological_watchdog_alive") else bad),
            ("memory system", ok if data.get("memory_system_loaded") else bad),
            ("scheduler jobs", data.get("scheduler_jobs")),
        ]
        for pool, urls in (data.get("nodes") or {}).items():
            if urls:
                rows.append((f"node {pool}", ", ".join(urls)))
        for key, val in rows:
            line = Text.assemble(("  "), (f"{key:<16}", "mute"))
            line.append_text(Text.assemble(val) if isinstance(val, tuple)
                             else Text(_safe(val)))
            console.print(line)

    def cmd_effort(self, args: list[str]) -> None:
        """/effort [level] — set (or, bare, show) the reasoning effort sent
        with this client's messages. Health is asked either way: while the
        agent's switch is off the header is ignored, and saying so beats a
        level that silently does nothing."""
        if len(args) > 1 or (args and args[0].lower() not in EFFORT_ALIASES):
            self.notice("usage: /effort [default|low|med|xhigh]", "err")
            return
        if args:
            new = EFFORT_ALIASES[args[0].lower()]
            changed = new != self.effort
            self.effort = new
            self.notice(f"✓ effort: {EFFORT_LABELS[new]}"
                        + (" (the model server's own level)" if not new else ""), "mute")
            if changed:
                self.notice("a change of level re-processes this conversation once on the "
                            "next message (seconds; longer for a long conversation)", "faint")
        else:
            self.notice(f"effort: {EFFORT_LABELS[self.effort]}", "mute")
        try:
            status, data = self.api.health(timeout=(2, 5))
        except requests.RequestException:
            return
        if status == 200 and isinstance(data, dict) and data.get("reasoning_effort") is not True:
            self.notice("the agent's effort switch is off (GHOST_REASONING_EFFORT) — "
                        "the level is ignored until it is on", "notice")

    def cmd_turns(self) -> None:
        status, data = self.api.turns()
        if status != 200:
            return self.fail(status, data)
        turns = data.get("turns", [])
        if not turns:
            return self.notice("no turns in flight", "mute")
        rows = [[t.get("request_id", "?")[:16],
                 "running" if t.get("running") else "queued",
                 _dur(t.get("age_s")),
                 _trim(t.get("preview"), 50)]
                for t in turns]
        _table(["request", "state", "age", "preview"], rows)

    def cmd_cancel(self, hard: bool) -> None:
        status, data = self.api.cancel_turn(hard=hard)
        if status == 200 and isinstance(data, dict) and data.get("cancelled"):
            # §4ML: this cancels WHATEVER turn the agent is running — from any
            # client (the REPL never has a turn of its own in flight here) —
            # so say which one it was
            mode = "hard-cancelled" if data.get("mode") == "hard" else "cancelled (cooperative)"
            rid = _safe(str(data.get("request_id") or "?"))
            self.notice(f"⛔ turn {rid} {mode}", "mute")
        elif status == 404:
            self.notice("nothing to cancel — no turn running", "mute")
        else:
            self.fail(status, data)

    def cmd_notify(self) -> None:
        status, data = self.api.notifications(NOTIFY_CONSUMER)
        if status != 200:
            return self.fail(status, data)
        if not data.get("enabled"):
            return self.notice("autonomous-activity notifications are disabled")
        if data.get("quiet_hours"):
            # §4ML: quiet hours HOLD notices — "no new notifications" was false
            held = data.get("held")
            if held == 0:
                return self.notice("no new notifications (quiet hours)", "mute")
            what = f"{held} notification(s)" if isinstance(held, int) else "notifications"
            return self.notice(f"quiet hours — the agent is holding {what}; "
                               "they will show here afterwards", "mute")
        records = data.get("records", [])
        watermark = data.get("watermark", 0)
        if data.get("baseline"):
            self.api.notifications_ack(NOTIFY_CONSUMER, watermark)
            return self.notice("notification feed baselined — new agent "
                               "activity will show up here from now on", "mute")
        if not records:
            return self.notice("no new notifications", "mute")
        for r in records:
            sev = str(r.get("severity", ""))
            sev_style = "err" if sev in ("error", "critical") else "notice"
            console.print(Text.assemble(
                "  ", (f"{_ago(r.get('ts')):>8}", "mute"), "  ",
                (f"{_safe(r.get('phase') or '?'):<14}", sev_style),
                (_trim(r.get("summary"), 90), "")))
        # Ack AFTER displaying — a crash mid-print re-serves them next time.
        ack_status, _ = self.api.notifications_ack(NOTIFY_CONSUMER, watermark)
        if ack_status == 200:
            self.notice(f"({len(records)} notification(s) acknowledged)", "mute")
        else:
            self.notice(f"(could not acknowledge — HTTP {ack_status}; these will "
                        f"show again next time)", "err")

    def cmd_memory(self, sub: str, args: list[str]) -> None:
        if sub == "fix" and len(args) == 2:
            status, data = self.api.memory_correct(args[0], args[1])
        elif sub == "rm" and len(args) == 1:
            status, data = self.api.memory_delete(args[0])
        else:
            return self.notice(
                'usage: /memory fix "<match>" "<replacement>"  ·  '
                '/memory rm "<match>"')
        if status == 200 and isinstance(data, dict) and data.get("ok"):
            detail = json.dumps({k: v for k, v in data.items() if k != "ok"})
            self.notice(f"✓ memory updated: {detail}", "ok")
        else:
            self.fail(status, data)

    # -- files / workspace -------------------------------------------------------
    def cmd_upload(self, arg: str) -> None:
        path = Path(arg).expanduser()
        if not path.is_file():
            return self.notice(f"✖ not a file: {path}", "err")
        with console.status(Text(f"uploading {path.name}…", style="mute"),
                            spinner="dots"):
            status, data = self.api.upload(path)
        if status == 200:
            self.notice(f"✓ {data.get('filename', path.name)} → agent sandbox", "ok")
        else:
            self.fail(status, data)

    def cmd_download(self, name: str, dest_arg: str) -> None:
        dest = Path(dest_arg).expanduser() if dest_arg else Path(Path(name).name)
        if dest.is_dir():
            dest = dest / Path(name).name
        with console.status(Text(f"downloading {name}…", style="mute"),
                            spinner="dots"):
            status, size = self.api.download(name, dest)
        if status == 200:
            self.notice(f"✓ {dest} ({size:,} bytes)", "ok")
        else:
            # NO unlink here. The writer never opened dest on a non-200, so
            # this "cleanup" deleted whatever local file happened to share
            # the name — the operator's own report.pdf, verified.
            self.notice(f"✖ HTTP {status} — no such file in the sandbox? "
                        f"({dest} was left alone)", "err")

    def cmd_save(self, arg: str) -> None:
        dest = (Path(arg).expanduser() if arg
                else Path(time.strftime("workspace_%Y%m%d-%H%M%S.zip")))
        with console.status(Text("packing workspace…", style="mute"),
                            spinner="dots"):
            status, size = self.api.workspace_save(self.history, dest)
        if status == 200:
            self.notice(f"✓ workspace saved → {dest} ({size:,} bytes)", "ok")
        else:
            # Same as /download: dest was never opened, so unlinking it here
            # destroyed an unrelated pre-existing file of that name.
            self.notice(f"✖ HTTP {status} — workspace save failed "
                        f"({dest} was left alone)", "err")

    def cmd_load(self, arg: str) -> None:
        path = Path(arg).expanduser()
        if not path.is_file():
            return self.notice(f"✖ not a file: {path}", "err")
        self.notice("this REPLACES the agent's sandbox and scratchpad "
                    "with the archive's contents")
        if not Confirm.ask("proceed?", default=False, console=console):
            return self.notice("cancelled", "mute")
        with console.status(Text("restoring workspace…", style="mute"),
                            spinner="dots"):
            status, data = self.api.workspace_load(path)
        if status == 200:
            restored = data.get("chat_history") or []
            if restored:
                self.history = list(restored)
                self._reset_turn_refs()   # restored turns carry no req_ids
            self.notice(f"✓ workspace restored ({len(restored)} chat messages)", "ok")
        else:
            self.fail(status, data)

    # -- projects -----------------------------------------------------------------
    def _resolve_project(self, prefix: str) -> str | None:
        status, data = self.api.projects_list()
        if status != 200:
            self.fail(status, data)
            return None
        ids = [p.get("id", "") for p in data.get("projects", [])]
        if prefix in ids:
            return prefix
        hits = [i for i in ids if i.lower().startswith(prefix.lower())]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            self.notice(f"ambiguous — matches {', '.join(hits)}")
        else:
            self.notice(f"✖ no project matching '{prefix}'", "err")
        return None

    def cmd_projects(self) -> None:
        status, data = self.api.projects_list()
        if status != 200:
            return self.fail(status, data)
        projects = data.get("projects", [])
        if not projects:
            return self.notice("no projects yet — /project new \"title\"", "mute")
        current = data.get("current")
        rows = [[("▸" if p.get("id") == current else " "),
                 str(p.get("id", "?")),
                 str(p.get("status", "?")),
                 str(p.get("kind", "")),
                 _trim(p.get("title"), 44)]
                for p in projects]
        _table([" ", "id", "status", "kind", "title"], rows)

    def cmd_project(self, sub: str, args: list[str]) -> None:
        if sub == "new":
            if not args:
                return self.notice('usage: /project new "title" ["goal"]')
            status, data = self.api.project_create(
                args[0], args[1] if len(args) > 1 else "")
            if status == 201:
                self.notice(f"✓ project created · {data.get('id')}", "ok")
            else:
                self.fail(status, data)
            return

        if not args:
            return self.notice(f"usage: /project {sub} <id>")
        pid = self._resolve_project(args[0])
        if pid is None:
            return

        if sub == "info":
            status, data = self.api.project_get(pid)
            if status != 200:
                return self.fail(status, data)
            for key in ("id", "title", "kind", "status", "goal"):
                if data.get(key):
                    console.print(Text.assemble(
                        "  ", (f"{key:<10}", "mute"),
                        (_trim(data[key], 100), "")))
            if data.get("updated_at"):
                console.print(Text.assemble(
                    "  ", (f"{'updated':<10}", "mute"),
                    (_ago(data["updated_at"]), "")))
        elif sub in ("use", "resume"):
            call = (self.api.project_switch if sub == "use"
                    else self.api.project_resume)
            status, data = call(pid)
            if status != 200:
                return self.fail(status, data)
            self.notice(f"✓ active project → {pid}", "ok")
            briefing = (data or {}).get("briefing")
            if briefing:
                console.print(Text(_safe(briefing), style="mute"))
        elif sub == "advance":
            with console.status(Text(f"advancing {pid}…", style="mute"),
                                spinner="dots"):
                status, data = self.api.project_advance(pid)
            if status != 200:
                return self.fail(status, data)
            mark = ("✓", "ok") if data.get("ok") else ("✗", "err")
            console.print(Text.assemble(
                "  ", mark, f" {data.get('classification', '?')} · "
                f"task {data.get('task_id', '—')}"))
            if data.get("summary"):
                console.print(Text(f"  {_trim(data['summary'], 400)}"))
        elif sub == "tasks":
            status, data = self.api.project_tasks(pid)
            if status != 200:
                return self.fail(status, data)
            tasks = data.get("tasks", [])
            if not tasks:
                return self.notice("no tasks in this project", "mute")
            icons = {"DONE": ("✓", "ok"), "FAILED": ("✗", "err"),
                     "IN_PROGRESS": ("▸", "notice"), "BLOCKED": ("⊘", "err")}
            for t in tasks:
                st = str(t.get("status", "")).upper()
                console.print(Text.assemble(
                    "  ", icons.get(st, ("·", "mute")), " ",
                    (f"{_safe(t.get('id'))[:8]}", "mute"), " ",
                    (_trim(t.get("description"), 76), "")))
        else:
            self.notice(f"unknown subcommand '/project {sub}' — see /help")

    # -- dispatch -------------------------------------------------------------
    def dispatch(self, line: str) -> bool:
        """Handle one input line. Returns False when the REPL should exit."""
        lowered = line.lower()
        if lowered in ("/exit", "/quit", "/bye", "exit", "quit"):
            return False
        if not line.startswith("/"):
            self.chat_turn(line)
            return True

        try:
            # Rating is parsed off the RAW line, BEFORE shlex: a failure
            # reason is free text and `/bad it didn't find the file` would
            # die in shlex.split with "No closing quotation" — losing the
            # label to a quoting rule the operator never opted into.
            head, _, rest = line.partition(" ")
            signal = RATE_CMDS.get(head.lower())
            if signal:
                self.cmd_rate(signal, rest.strip())
                return True

            try:
                parts = shlex.split(line)
            except ValueError as e:
                self.notice(f"✖ {e} — quote arguments like "
                            f"/memory fix \"a\" \"b\"", "err")
                return True
            if not parts:
                return True
            cmd, args = parts[0].lower(), parts[1:]

            match cmd:
                case "/help":
                    console.print(HELP)
                case "/clear":
                    self.cmd_clear()
                case "/new":
                    self.cmd_new(" ".join(args))
                case "/sessions" if args[:1] == ["rm"] and len(args) == 2:
                    sid = self._resolve_session(args[1])
                    if sid:
                        status, data = self.api.session_delete(sid)
                        if status == 200:
                            self.notice(f"✓ session {sid[:8]} deleted", "mute")
                        else:
                            self.fail(status, data)
                case "/sessions" if not args:
                    self.cmd_sessions()
                case "/resume" if len(args) == 1:
                    self.cmd_resume(args[0])
                case "/health":
                    self.cmd_health()
                case "/turns":
                    self.cmd_turns()
                case "/effort":
                    self.cmd_effort(args)
                case "/cancel":
                    self.cmd_cancel(hard=args[:1] == ["hard"])
                case "/interrupt":
                    self.cmd_interrupt()
                case "/notify":
                    self.cmd_notify()
                case "/memory" if args:
                    self.cmd_memory(args[0].lower(), args[1:])
                case "/upload" if args:
                    self.cmd_upload(" ".join(args))
                case "/download" if len(args) in (1, 2):
                    self.cmd_download(args[0], args[1] if len(args) == 2 else "")
                case "/save":
                    self.cmd_save(" ".join(args))
                case "/load" if args:
                    self.cmd_load(" ".join(args))
                case "/projects":
                    self.cmd_projects()
                case "/project" if args:
                    self.cmd_project(args[0].lower(), args[1:])
                case _:
                    self.notice(f"unknown or incomplete command '{line}' — "
                                f"see /help (plain text talks to the agent)")
        except requests.RequestException as e:
            self.notice(f"✖ {type(e).__name__}: cannot reach the agent", "err")
        except Exception as e:      # noqa: BLE001 — one bad payload, not one
            # dead session. This caught only RequestException, so a single
            # unexpected response shape ended the REPL and took the local
            # history and the rateable turn refs with it (verified: a
            # session row missing "id" → KeyError; rss_limit_mb as a string
            # → ValueError). A command may fail; the session may not.
            self.notice(f"✖ {type(e).__name__}: {e} — command failed, "
                        f"session intact", "err")
        return True

    # -- main loop -------------------------------------------------------
    def chat(self) -> None:
        # §4ML: every prompt the operator types lands here — owner-only
        try:
            HISTORY_FILE.touch(mode=0o600, exist_ok=True)
            HISTORY_FILE.chmod(0o600)
        except OSError:
            pass
        self.prompt_session = PromptSession(
            key_bindings=bindings,
            style=PROMPT_STYLE,
            completer=COMPLETER,
            history=FileHistory(str(HISTORY_FILE)),
            auto_suggest=AutoSuggestFromHistory(),
            # prompt_toolkit reserves EIGHT rows for the completion menu by
            # default, for the whole session, whether or not a menu is
            # showing. That is the permanent blank gap under the prompt —
            # and because those rows are a scrolling redraw region, every
            # frame leaves the prompt character behind in scrollback, which
            # smears a block glyph into a continuous vertical bar down the
            # left of the transcript (operator screenshot, 2026-08-27).
            # Reserve nothing and complete like a shell instead: Tab lists,
            # which is what the banner has always promised.
            reserve_space_for_menu=0,
            complete_style=CompleteStyle.READLINE_LIKE,
            complete_while_typing=False,
            bottom_toolbar=self.status_toolbar,
        )
        self._start_status_refresh()
        self.banner()
        while True:
            if self._outbox:                # §4RZ: held messages, in order
                try:
                    self._send_outbox()
                except KeyboardInterrupt:
                    # Ctrl-C stops the queue: what is left goes back into
                    # the prompt, never dropped (review r3 nit b).
                    console.print(Text("⛔ interrupted", style="mute"))
                    self._restored[:0] = list(self._outbox)
                    self._outbox.clear()
                continue
            try:
                draft = self._take_draft()
                if draft:                   # unsent text back in the prompt
                    line = self.prompt_session.prompt(
                        [("class:p", PROMPT_GLYPH)], default=draft)
                else:
                    line = self.prompt_session.prompt([("class:p", PROMPT_GLYPH)])
            except EOFError:
                break
            except KeyboardInterrupt:
                # Ctrl-C clears the line; Ctrl-D exits. These shared a
                # `break`, so the key /help advertises as "aborts a reply"
                # also ended the session when used to drop a mistyped line.
                continue
            if line is None:                        # Ctrl-D
                break
            line = line.strip()
            if not line:
                continue
            try:
                if not self.dispatch(line):
                    break
            except KeyboardInterrupt:
                # Last line of defence for an interrupt raised somewhere a
                # command didn't expect one. Individual paths handle their
                # own (see _abort_turn; a busy turn holds Ctrl-C, _salvage).
                console.print(Text("⛔ interrupted", style="mute"))
        console.print(Text("👋 disconnected", style="dim"))


# --- one-shot (scripting) mode ---------------------------------------------

def one_shot(api: GhostAPI, prompt: str, session_id: str | None,
             effort: str = "") -> int:
    """Send one message and stream the reply to stdout — rendered Markdown
    when stdout is a terminal, raw text when piped (script-friendly).
    With --session the server merges the stored history in, so this can
    continue a real conversation from a shell script."""
    body: dict[str, Any] = {"messages": [{"role": "user", "content": prompt}],
                            "stream": True}
    if session_id:
        body["session_id"] = session_id
    render = sys.stdout.isatty()
    printer = _StreamPrinter()
    # Kept in a name (it used to be inlined into the header dict) so the
    # Ctrl-C path below can cancel THIS turn server-side.
    request_id = uuid.uuid4().hex[:16]

    def _finish() -> None:
        """Flush the still-open block. Reached from the normal path AND
        from ``finally`` (idempotent), so an abort/error mid-stream still
        leaves the partial reply visible — completed blocks already flowed
        into the scroll as they streamed."""
        printer.settle()

    try:
        # §4MP: piped output cannot take back streamed text — ask for the
        # finished reply only (no retracts); a terminal gets live tokens
        _hdrs = {"X-Request-ID": request_id}
        if effort:                                  # §4RB: --effort
            _hdrs["X-Ghost-Effort"] = effort
        if not render:
            _hdrs["X-Ghost-Stream"] = "final"
        with api.http.post(api._url("/v1/chat/completions"), json=body,
                           headers=_hdrs,
                           stream=True, timeout=(10, None)) as resp:
            if resp.status_code != 200:
                try:
                    detail = api.error_of(resp.json())
                except ValueError:
                    detail = (resp.text or "").strip()[:300]
                print(f"ghost: HTTP {resp.status_code}: {detail}", file=sys.stderr)
                return 1
            got_error = False
            held = None                        # §4KP: a list while the reply is held
            saw_done = False
            for raw in resp.iter_lines():
                if not raw:
                    continue
                line = raw.decode("utf-8", "replace")
                if not line.startswith("data: "):
                    continue
                data = line[6:]
                if data == "[DONE]":
                    saw_done = True
                    break
                try:
                    obj = json.loads(data)
                except json.JSONDecodeError:
                    continue
                if obj.get("error"):
                    print(f"ghost: {api.error_of(obj)}", file=sys.stderr)
                    got_error = True
                    break
                # Sanitized HERE, not in feed(): the piped branch below
                # bypasses the printer entirely, and `ghost -p q | less -R`
                # is still a terminal on the other end.
                if (obj.get("ghost") or {}).get("retract") is True:
                    # §4MP (a terminal: piped output asked for no retracts)
                    if held is not None:
                        held.clear()
                    elif render and printer.text:
                        printer.settle()
                        console.print(Text(" " * GUTTER + "↺ revised — the reply continues below", style="mute"))
                        printer = _StreamPrinter()
                    continue
                if (obj.get("ghost") or {}).get("reasoning_unparsed") is True and held is None:
                    held = []
                chunk = _safe((obj.get("choices") or [{}])[0]
                              .get("delta", {}).get("content", ""))
                if not chunk:
                    continue
                if held is not None:           # §4KP: complete, then strip
                    held.append(chunk)
                    continue
                if render:
                    printer.feed(chunk)
                else:
                    sys.stdout.write(chunk)
                    sys.stdout.flush()
            if held is not None and saw_done and not got_error:
                chunk, held = strip_orphan_think_close("".join(held)), None
                if render:
                    printer.feed(chunk)
                else:
                    sys.stdout.write(chunk)
                    sys.stdout.flush()
            _finish()
            if not render:
                sys.stdout.write("\n")
            return 1 if got_error else 0
    except KeyboardInterrupt:
        # Turns are globally SERIALIZED on the agent: an abandoned one-shot
        # keeps working and keeps the lock, wedging every other client. The
        # REPL has always cancelled server-side; this path did not, so a
        # Ctrl-C'd script blocked the agent until the turn finished on its
        # own. Same cancel, same request id.
        _finish()
        try:
            status, data = api.cancel_turn(request_id=request_id)
            cancelled = (status == 200 and isinstance(data, dict)
                         and data.get("cancelled"))
            print("ghost: aborted — agent turn cancelled" if cancelled
                  else "ghost: aborted (turn already finished)",
                  file=sys.stderr)
        except (requests.RequestException, KeyboardInterrupt):
            print("ghost: aborted locally — could not reach the agent to "
                  "cancel; the turn may still hold the lock", file=sys.stderr)
        return 130
    except requests.RequestException as e:
        print(f"ghost: {type(e).__name__}: cannot reach the agent", file=sys.stderr)
        return 1
    finally:
        _finish()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Ghost Agent CLI — chat, sessions, files, projects, ops.")
    parser.add_argument("--url", default=DEFAULT_HOST, help="Agent URL")
    parser.add_argument("--key", default=DEFAULT_KEY, help="API key (X-Ghost-Key)")
    parser.add_argument("-p", "--prompt", metavar="TEXT",
                        help="one-shot: send TEXT ('-' reads stdin), print reply, exit")
    parser.add_argument("--session", metavar="ID",
                        help="server-side session id to resume / continue")
    parser.add_argument("--effort", choices=sorted(set(EFFORT_ALIASES) - {"auto", "off"}),
                        help="reasoning effort for this run's messages (the REPL's /effort); "
                             "default = the model server's own level")
    parser.add_argument("--health", action="store_true",
                        help="print agent health and exit")
    parser.add_argument("--probe", action="store_true",
                        help="mark every turn as a diagnostic probe (X-Ghost-Origin: probe): "
                             "it runs normally but never teaches the agent")
    args = parser.parse_args()
    effort = EFFORT_ALIASES.get(args.effort or "default", "")

    api = GhostAPI(args.url, args.key)
    if args.probe:
        api.http.headers["X-Ghost-Origin"] = "probe"

    if args.health:
        cli = GhostCLI(api)
        try:
            cli.cmd_health()
        except requests.RequestException as e:
            print(f"ghost: {type(e).__name__}: cannot reach the agent",
                  file=sys.stderr)
            return 1
        return 0

    prompt = args.prompt
    if prompt is None and not sys.stdin.isatty():
        prompt = sys.stdin.read()          # `echo q | ghost` == `ghost -p -`
    if prompt is not None:
        if prompt == "-":
            prompt = sys.stdin.read()
        prompt = prompt.strip()
        if not prompt:
            print("ghost: empty prompt", file=sys.stderr)
            return 1
        return one_shot(api, prompt, args.session, effort)

    cli = GhostCLI(api, session_id=args.session)
    cli.effort = effort
    if args.session:
        try:
            cli.cmd_resume(args.session)
        except requests.RequestException:
            cli.notice("(couldn't resume that session — starting fresh)", "mute")
    cli.chat()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        sys.exit(130)
