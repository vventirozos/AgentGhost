# --- untrusted text → terminal ---------------------------------------------
# rich strips only BEL/BS/VT/FF/CR (rich.control.STRIP_CONTROL_CODES = [7, 8,
# 11, 12, 13]). ESC is NOT in that set, so every CSI and ST-terminated OSC in
# agent- or server-supplied text reached the terminal RAW — verified:
# \x1b[2J (clear), \x1b[?1049h (alt screen) and \x1b]52;c;<b64>\x1b\\, which
# WRITES THE OPERATOR'S CLIPBOARD. This agent summarizes Tor-fetched pages,
# and the CLI is the only client that renders into a terminal instead of into
# HTML (the web UI and Slack escape by construction), so strip at every point
# where untrusted text becomes output: reply chunks, notices, table cells,
# trimmed previews, titles.
_UNSAFE_CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def _safe(text: Any) -> str:
    """Untrusted text → printable. Keeps newline and tab; drops ESC, the C0
    controls rich lets through, DEL, and the C1 range (U+009B is a one-byte
    CSI, so half-stripping would leave a working escape introducer)."""
    return _UNSAFE_CTRL_RE.sub("", str(text if text is not None else ""))


# --- small formatting helpers ---------------------------------------------

def _ago(ts: float | None) -> str:
    """'42s ago' / '3m ago' / '5h ago' / '2d ago' from an epoch float."""
    if not ts:
        return "—"
    d = max(0.0, time.time() - float(ts))
    if d < 90:
        return f"{d:.0f}s ago"
    if d < 5400:
        return f"{d / 60:.0f}m ago"
    if d < 129600:
        return f"{d / 3600:.0f}h ago"
    return f"{d / 86400:.0f}d ago"


def _dur(seconds: float | None) -> str:
    if seconds is None:
        return "—"
    s = int(seconds)
    if s < 90:
        return f"{s}s"
    if s < 5400:
        return f"{s // 60}m {s % 60}s"
    if s < 129600:
        return f"{s // 3600}h {s % 3600 // 60}m"
    return f"{s // 86400}d {s % 86400 // 3600}h"


def _tok(n: int) -> str:
    """Token count, compact: 840 · 31.2k · 129k."""
    if n < 1000:
        return str(n)
    # 99,950+ would print "100.0k": whole thousands from there
    return f"{n / 1000:.1f}k" if n < 99_950 else f"{round(n / 1000)}k"


def _trim(text: Any, width: int) -> str:
    text = " ".join(_safe(text).split())
    return text if len(text) <= width else text[: width - 1] + "…"


def _table(headers: list[str], rows: list[list[str]]) -> None:
    """Muted-header, borderless table, aligned to the gutter. Cells are plain
    text (never parsed as rich markup — titles/previews can contain
    anything)."""
    if not rows:
        return
    t = Table(box=None, header_style="mute", pad_edge=False,
              padding=(0, 2, 0, 0))
    for h in headers:
        t.add_column(h)
    for r in rows:
        t.add_row(*[Text(_safe(c)) for c in r])
    console.print(Padding(t, (0, 0, 0, GUTTER)))


def _fit_line(head: list, optional: list[list], tail: Text | None = None,
              width: int | None = None) -> Text:
    """``head`` + as many ``optional`` groups as fit + ``tail``, dropping
    optional groups from the TAIL until the line fits the terminal.

    Chrome that wraps is worse than chrome that says less: the old banner
    assembled every segment unconditionally and spilled onto a second line
    in any window narrower than its content. Both the banner and its hint
    line go through this, so they cannot drift apart in how they degrade."""
    w = console.width if width is None else width
    groups = list(optional)
    while True:
        parts = list(head)
        for group in groups:
            parts.extend(group)
        line = Text.assemble(*parts)
        if tail is not None:
            line.append_text(tail)
        if line.cell_len <= w - 1:
            return line
        if not groups:
            # Nothing optional left and it STILL doesn't fit (a very narrow
            # window, or a long hostname). Truncating is the guarantee —
            # without it the invariant held only while something remained
            # to drop, which is exactly when it stops being tested.
            line.truncate(max(1, w - 1), overflow="ellipsis")
            return line
        groups.pop()          # drop the least important survivor, retry


def _rule(width: int | None = None) -> Text:
    """A separator that spans the terminal. It used to be a hardcoded 52
    characters, so it under-ran a wide window and the banner it belonged to
    WRAPPED in a narrow one."""
    w = max(8, (width if width is not None else console.width) - GUTTER * 2)
    return Text(" " * GUTTER + "─" * w, style="faint")


def _flush_point(text: str, start: int) -> int:
    """Index just past the LAST markdown block boundary (a blank line at
    even code-fence parity) in ``text[start:]`` — everything before it is
    a COMPLETE block that can be printed permanently. ``start`` when no
    complete block is pending. Scans only the pending region, so the cost
    over a whole stream is linear."""
    point = start
    in_fence = False
    pos = start
    while True:
        nl = text.find("\n", pos)
        if nl == -1:
            break
        line = text[pos:nl]
        if line.lstrip().startswith(("```", "~~~")):
            in_fence = not in_fence
        if not in_fence and not line.strip():
            point = nl + 1
        pos = nl + 1
    return point



# §4KP: the agent's `ghost.reasoning_unparsed` frame says this reply's opening
# may be reasoning that ends in an orphan </think> (the model server did not
# route it to the reasoning channel). Printed text cannot be taken back, so
# the reply is held until complete and stripped here — the mirror of
# agent._strip_orphan_think_close (a parity test pins the two together).
_ORPHAN_CLOSE_RE = re.compile(r'\A.*?(?:\A|\n)</think(?:ing)?[ \t]*>[ \t]*\r?\n[ \t]*\r?\n',
                              re.DOTALL | re.IGNORECASE)
_FENCE_SPAN_RES = (re.compile(r"```.*?```", re.DOTALL), re.compile(r"~~~.*?~~~", re.DOTALL))


def strip_orphan_think_close(text):
    if not isinstance(text, str) or "</think" not in text.lower() or text.lstrip().startswith("{"):
        return text
    fences = []

    def _shield(m):
        fences.append(m.group(0))
        return f"\x00FENCE{len(fences) - 1}\x00"
    shielded = text
    for rx in _FENCE_SPAN_RES:
        shielded = rx.sub(_shield, shielded)
    out = _ORPHAN_CLOSE_RE.sub("", shielded, count=1)
    for i in range(len(fences) - 1, -1, -1):          # outer shields hold inner ones
        out = out.replace(f"\x00FENCE{i}\x00", fences[i])
    return out


class _StreamPrinter:
    """Progressive streaming renderer: the reply FLOWS INTO THE NORMAL
    SCROLL like any terminal program (operator requirement — "use the
    whole screen"), fully markdown-rendered, with no settle-time reprint.

    Completed blocks print permanently the moment their boundary arrives
    (rich routes prints ABOVE an active Live region); only the current
    in-progress block rides a small transient tail. This keeps the two
    hard constraints compatible: markdown can't re-render lines already
    printed (so only FINISHED blocks may print), and a Live region can't
    exceed the screen (so only the UNFINISHED block may live there —
    it is naturally small; _TailCrop guards the rare giant one)."""

    def __init__(self, tail: Any = None, muted: Any = None,
                 lock: Any = None) -> None:
        self.text = ""
        self.upto = 0
        self.live: Live | None = None
        # §4RZ 6b (busy prompt): ``tail`` takes the still-open block instead
        # of a rich Live — prompt_toolkit draws it above the live prompt, so
        # no Live ever runs under patch_stdout. ``muted`` (a callable) stops
        # all output once the turn was stopped from the prompt; ``lock``
        # makes a feed and that stop's snapshot of text/upto atomic.
        # Unset, the printer behaves exactly as before.
        self.tail = tail
        self.muted = muted or (lambda: False)
        self._lock = lock or contextlib.nullcontext()

    def feed(self, chunk: str) -> None:
        with self._lock:
            self._feed(chunk)

    def _feed(self, chunk: str) -> None:
        # THE choke point for the rendered path: everything the agent says
        # becomes terminal output here, and self.text is what the caller
        # keeps as history / hands to /save. Sanitizing at the call sites
        # instead would leave the guard one refactor away from being
        # bypassed by a new one.
        self.text += _safe(chunk)
        if self.muted():
            return
        fp = _flush_point(self.text, self.upto)
        if fp > self.upto:
            segment = self.text[self.upto:fp]
            if segment.strip():
                console.print(_reply_block(segment))
                console.print()   # inter-block spacing rich would have added
            self.upto = fp
        pending = self.text[self.upto:]
        if self.tail is not None:
            self.tail(pending if pending.strip() else "")
            return
        if pending.strip():
            if self.live is None:
                self.live = Live(console=console, refresh_per_second=12,
                                 transient=True)
                _reflow_safe(self.live)
                self.live.start()
            # _LazyMarkdown, not Markdown: parsing here re-parsed the whole
            # pending region on EVERY chunk, and when a reply has no blank
            # line to flush on — a table, a long bullet list — the pending
            # region IS the whole reply. Measured: a 400-row table cost
            # 12.24s against 0.07s for the same volume of prose, with
            # markdown_it.parse accounting for 14.6s of a 16.9s profile
            # (1410 calls, one per chunk). Deferred, the parse runs on
            # Live's refresh clock (12/s) instead of the token rate.
            self.live.update(_TailCrop(_LazyMarkdown(pending)))

    def settle(self) -> None:
        """Stop the live tail and print whatever block was still open —
        idempotent, safe from error/abort paths."""
        with self._lock:
            if self.live is not None:
                self.live.stop()
                self.live = None
            if self.tail is not None:
                self.tail("")
            if self.muted():
                return            # the stop that muted us printed the rest
            rest = self.text[self.upto:]
            self.upto = len(self.text)
            if rest.strip():
                console.print(_reply_block(rest))


def _reply_block(markup: str) -> Padding:
    """One block of the agent's reply, on the gutter. Every path that prints
    reply text goes through here so the transcript keeps one left edge — the
    settled blocks, the still-open tail, and the end-of-stream flush.

    A plain indent, deliberately: a coloured left rail would mark every
    reply line as the agent's, but it also prefixes every line the operator
    copies out of the terminal. Copy-clean won."""
    return Padding(Markdown(markup, code_theme=CODE_THEME),
                   (0, 0, 0, GUTTER))


class _LazyMarkdown:
    """Markdown parsed at RENDER time rather than at update time.

    ``Live.update()`` is called once per streamed chunk but rich only
    RENDERS on its own refresh tick, so building the Markdown object in
    ``feed()`` paid a full markdown_it parse per token for a document that
    was thrown away unrendered ~90% of the time. Holding the markup and
    parsing inside ``__rich_console__`` moves that cost onto the refresh
    clock. Kept separate from _TailCrop so the crop stays a plain
    renderable wrapper (and its own tests keep testing only cropping)."""

    def __init__(self, markup: str):
        self.markup = markup

    def __rich_console__(self, console: Console,
                         options: ConsoleOptions) -> RenderResult:
        yield _reply_block(self.markup)


class _TailCrop:
    """Stream-safe live view: the last rendered lines that fit the screen.

    A Live region taller than the terminal cannot be repainted — the cursor
    can't move above the top row, so each refresh erases only the top
    screenful, reprints the whole reply from the clamp point, and pushes a
    stale partial frame into scrollback (the "erratic / half-screen"
    transcripts on long replies; mid-stream markdown aggravates it — an
    unclosed ``` fence transiently renders everything after it as one tall
    code block). Cropping the live view to the tail keeps the region
    repaintable at any reply length; the FULL reply is printed once after
    the stream settles. rich's own crop/ellipsis overflow modes keep the
    TOP lines — the wrong end for chat."""

    def __init__(self, renderable: Any):
        self.renderable = renderable

    def __rich_console__(self, console: Console,
                         options: ConsoleOptions) -> RenderResult:
        lines = console.render_lines(self.renderable, options, pad=False)
        # A THIRD of the screen, not height-2: a region sized to ~the full
        # screen only repaints cleanly when it STARTS at the very top row —
        # true for the first turn of a fresh session (how this was tested)
        # and false for every turn after it (cursor starts mid-screen, the
        # region overflows the bottom, and the terminal's clamped partial
        # repaints shred mid-screen — operator report 2026-08-01: "finishes
        # at the middle of the screen" on long replies). A compact tail
        # fits below any reasonable start position; the FULL reply still
        # prints once at settle.
        max_h = max(8, min(options.size.height - 2,
                           options.size.height // 3))
        if len(lines) > max_h:
            lines = lines[-max_h:]
        new_line = Segment.line()
        for i, line in enumerate(lines):
            if i:
                yield new_line
            yield from _rstrip_line(line)


def _rstrip_line(line: list) -> list:
    """A rendered line without its trailing pad. rich pads every line to the
    full console width; a line exactly as wide as the terminal wraps onto a
    second row the moment the pane narrows by ONE column, so the live tail
    keeps only the cells that carry text. Padding with a background colour
    (a code block's fill) is kept — stripping it would be visible."""
    segs = list(line)
    while segs and not segs[-1].control and not segs[-1].text.strip() \
            and not (segs[-1].style and segs[-1].style.bgcolor):
        segs.pop()
    if segs and not segs[-1].control \
            and not (segs[-1].style and segs[-1].style.bgcolor):
        last = segs[-1]
        segs[-1] = Segment(last.text.rstrip(), last.style, last.control)
    return segs


#: How long the width must hold before the live tail is drawn again after a
#: resize: tmux's ~250 ms report coalescing plus an ssh hop.
RESIZE_QUIET_S = 0.5


class _ReflowLiveRender(LiveRender):
    """rich's LiveRender, erasing the previous frame by the ROWS it covers
    NOW rather than the lines it had when drawn.

    rich moves the cursor up once per rendered line. When the pane narrows
    mid-stream (window drag, tmux zoom, a smaller client attaching) the
    terminal reflows each line onto ceil(cells / width) rows, the cursor-up
    count falls short, and every refresh leaves the frame's top row behind —
    operator report 2026-10-28: the reply's last paragraph repeated 9 times
    in the tmux CLI pane (reproduced by shrinking a tmux window one column
    per chunk). Assumes a reflowing terminal (tmux, iTerm2, Terminal.app,
    Ghostty, kitty, WezTerm all are); at an unchanged width the count is
    exactly rich's.

    The width the CLI can read LAGS the screen during a drag: tmux reflows
    the pane at once but reports the new size to the program at most every
    ~250 ms (measured: 118 and 110 never reported during a 126→98 drag; an
    isolated resize arrives in 2 ms), and ssh adds its own delay. Any erase
    computed in that gap counts at the old width. So once a width change is
    seen, the live tail stays EMPTY until the width has held for
    RESIZE_QUIET_S — an empty frame has no rows to miscount, and the text
    reappears when the resizing stops."""

    def __init__(self, *args: Any, **kwargs: Any) -> None:
        super().__init__(*args, **kwargs)
        self._cells: list[int] = []
        self._console: Console | None = None
        self._width: int | None = None
        self._quiet_until = 0.0

    def __rich_console__(self, console: Console,
                         options: ConsoleOptions) -> RenderResult:
        self._console = console
        now = time.monotonic()
        width = options.size.width
        if self._width is not None and width != self._width:
            self._quiet_until = now + RESIZE_QUIET_S
        self._width = width
        if now < self._quiet_until:
            self._shape, self._cells = None, []
            return
        segs = list(super().__rich_console__(console, options))
        self._cells = [Segment.get_line_length(line)
                       for line in Segment.split_lines(segs)]
        yield from segs

    def _rows(self) -> int:
        """Rows the last frame covers at the terminal's current width."""
        if self._shape is None or not self._shape[1]:
            return 0
        width = self._console.size.width if self._console else 0
        if width <= 0 or len(self._cells) != self._shape[1]:
            return self._shape[1]
        return sum(max(1, -(-n // width)) for n in self._cells)

    def position_cursor(self) -> Control:
        rows = self._rows()
        if not rows:
            return Control()
        return Control(ControlType.CARRIAGE_RETURN,
                       (ControlType.ERASE_IN_LINE, 2),
                       *(((ControlType.CURSOR_UP, 1),
                          (ControlType.ERASE_IN_LINE, 2)) * (rows - 1)))

    def restore_cursor(self) -> Control:
        rows = self._rows()
        if not rows:
            return Control()
        return Control(ControlType.CARRIAGE_RETURN,
                       *((ControlType.CURSOR_UP, 1),
                         (ControlType.ERASE_IN_LINE, 2)) * rows)


def _reflow_safe(live: Live) -> Live:
    """Give a Live the resize-safe renderer (see _ReflowLiveRender). rich
    keeps it in a private attribute; if a rich upgrade moves it, the stream
    keeps rich's own behaviour rather than failing."""
    old = getattr(live, "_live_render", None)
    if isinstance(old, LiveRender):
        live._live_render = _ReflowLiveRender(
            old.renderable, old.style, old.vertical_overflow)
    return live


def _never_sent(exc: BaseException) -> bool:
    """True only when the request surely never reached the agent: the
    connection was refused or timed out while connecting. A read timeout,
    a reset mid-answer or anything else may come AFTER the agent acted
    (review r2: a slow inbox answer was injected AND re-sent)."""
    if isinstance(exc, requests.exceptions.ConnectTimeout):
        return True
    if not isinstance(exc, requests.exceptions.ConnectionError):
        return False
    from urllib3.exceptions import ConnectTimeoutError, NewConnectionError
    reason = getattr(exc.args[0], "reason", None) if exc.args else None
    return isinstance(reason, (NewConnectionError, ConnectTimeoutError)) \
        or isinstance(exc.args[0] if exc.args else None,
                      (NewConnectionError, ConnectTimeoutError))


#: How the agent ENDS the reply of a turn stopped cooperatively — by anyone
#: (core/agent.py, the TurnCancelled handler: "<partial>\n\n_(Turn cancelled:
#: <reason>.)_", or the note + " No output was produced before the
#: cancellation."). Anchored to the end: a reply that merely quotes the note
#: was not stopped (review r4). A HARD stop instead retracts the streamed
#: text and ends with [DONE] and no reply.
_STOPPED_NOTE_RE = re.compile(
    r"_\(Turn cancelled: [^\n]*?\.\)_"
    r"(?: No output was produced before the cancellation\.)?\Z")


#: The agent's own stop and hold words, COPIED (the CLI imports nothing
#: from src; tests/test_4rz_cli.py pins them equal to the source):
#: core/queued_messages._STOP_RE (the whole message stops a turn) and
#: tools/memory._DENY_RE (a message that holds or refuses). Matched on
#: memory/profile._fold text (casefold, accents stripped).
_STOP_RE = re.compile(r"(?:stop|cancel|abort|σταματα|σταματησε|ακυρο|ακυρωσε)[\s.!]*")
_DENY_RE = re.compile(
    r"(?<!\w)(?:no|nope|cancel|stop|wait|hold\s+on|abort|"
    r"οχι|μην|μη|ακυρο|ακυρωσε|σταματα|περιμενε)(?!\w)", re.IGNORECASE)


def _fold(text: Any) -> str:
    import unicodedata
    t = unicodedata.normalize("NFD", str(text or "").casefold())
    return "".join(ch for ch in t if not unicodedata.combining(ch))


def _is_hold_word(text: str) -> bool:
    """A stop or a hold ("stop", "wait", "no", "σταμάτα"…): sent later as
    a new request it would mean something else — it is never held for
    sending (review r5: typed before the turn registered, it came back as a
    fresh turn)."""
    f = _fold(text)
    return bool(_STOP_RE.fullmatch(f.strip()) or _DENY_RE.search(f))


class _Ended:
    """Busy-prompt result: the turn ended; ``text`` is the unsent draft."""
    def __init__(self, text: str = ""):
        self.text = text


class _Abort(_Ended):
    """Busy-prompt result: Ctrl-C — stop the turn; ``text`` is the draft."""


def _shut_socket(resp: Any) -> None:
    """Wake a thread blocked reading ``resp``: shutdown() makes its recv
    return at once (close() from another thread may not). Best effort —
    urllib3 1.x and 2.x keep the socket in different places."""
    import socket
    raw = getattr(resp, "raw", None)
    for get in (lambda: raw.connection.sock, lambda: raw._connection.sock,
                lambda: raw._fp.fp.raw._sock):
        try:
            sock = get()
        except Exception:                          # noqa: BLE001 — probing
            continue
        if sock is not None:
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            return


class _BusyView:
    """What the stream thread and the busy prompt share (§4RZ step 6b).

    The reply streams on a background thread; the main thread runs a live
    prompt under ``patch_stdout`` so the operator can type mid-turn.
    Completed blocks still print with ``console.print`` (patch_stdout puts
    them above the prompt). The still-open block and the spinner are NOT a
    rich Live here: a Live erases its frame by cursor-up counts, and under
    patch_stdout the prompt is erased and redrawn between its frames, so
    those counts would hit the prompt. They are drawn by prompt_toolkit
    instead, as the prompt's message (``message``), which it erases and
    redraws itself; the busy session erases its whole frame when it exits,
    so the tail never lands in scrollback."""

    def __init__(self) -> None:
        self.lock = threading.RLock()
        self.done = threading.Event()
        self.detached = False          # stopped from the prompt: worker muted
        self.waiting = False           # spinner up (no token yet)
        self.tail = ""
        self.printer: _StreamPrinter | None = None
        self.resp: Any = None
        self.app: Any = None           # the busy prompt's Application
        self.spinner = _BusySpinner(self)
        self._width: int | None = None
        self._quiet_until = 0.0
        self._cache: tuple = (None, "")

    # -- worker side -------------------------------------------------------
    def new_printer(self) -> _StreamPrinter:
        p = _StreamPrinter(tail=self.set_tail, muted=self.is_detached,
                           lock=self.lock)
        self.printer = p
        return p

    def is_detached(self) -> bool:
        return self.detached

    def set_tail(self, text: str) -> None:
        self.tail = text
        self.invalidate()

    def note(self, msg: str, style: str = "notice") -> None:
        with self.lock:
            if not self.detached:
                GhostCLI.notice(msg, style)

    def invalidate(self) -> None:
        app = self.app
        if app is not None and getattr(app, "is_running", False):
            try:
                app.invalidate()       # thread-safe in prompt_toolkit
            except Exception:          # noqa: BLE001 — a redraw is optional
                pass

    def finish(self) -> None:
        """The stream ended: end the busy prompt (it keeps the draft)."""
        self.done.set()
        app = self.app
        loop = getattr(app, "loop", None) if app is not None else None
        if loop is not None:
            try:
                loop.call_soon_threadsafe(self.exit_if_done)
            except RuntimeError:       # that run's loop already closed
                pass
        # A prompt not yet running sees `done` in its pre_run, and the
        # message re-checks it every BUSY_REFRESH_S as the last resort.

    # -- prompt side ---------------------------------------------------------
    def exit_if_done(self) -> None:
        app = self.app
        if not self.done.is_set() or app is None:
            return
        # The busy PromptSession (and its app) is shared by every turn. A
        # stream thread that outlived its stop finishes LATE, while the next
        # turn's prompt runs: only the view that owns the current run may
        # end it (review r1: a straggler ended turn 2's prompt).
        if getattr(app, "ghost_busy_owner", self) is not self:
            return
        try:
            if app.is_running and not app.future.done():
                app.exit(result=_Ended(app.current_buffer.text))
        except Exception:              # noqa: BLE001 — already exiting
            pass

    def detach(self) -> tuple[str, str]:
        """Stop from the prompt: mute the worker, wake it, and return
        (reply text so far, the part of it not printed yet)."""
        with self.lock:
            self.detached = True
            p = self.printer
            text, rest = (p.text, p.text[p.upto:]) if p is not None else ("", "")
            self.tail, self.waiting = "", False
        if self.resp is not None:
            _shut_socket(self.resp)
        return text, rest

    def _tail_ansi(self) -> str:
        size = shutil.get_terminal_size((80, 24))
        now = time.monotonic()
        # The resize lesson (_ReflowLiveRender): the width reported here
        # lags the screen during a drag, so the tail goes blank until the
        # width has held RESIZE_QUIET_S.
        if self._width is not None and size.columns != self._width:
            self._quiet_until = now + RESIZE_QUIET_S
        self._width = size.columns
        pending = self.tail
        if not pending.strip() or now < self._quiet_until:
            return ""
        key = (pending, size.columns, size.lines)
        if self._cache[0] == key:
            return self._cache[1]
        buf = io.StringIO()
        Console(file=buf, force_terminal=True,
                color_system=console.color_system or "truecolor",
                width=max(20, size.columns - 1), height=max(8, size.lines),
                theme=THEME, highlight=False,
                ).print(_TailCrop(_LazyMarkdown(pending)))
        self._cache = (key, buf.getvalue())
        return self._cache[1]

    def message(self) -> list:
        """The busy prompt's message: the live tail or the spinner, a blank
        line, then the prompt glyph. Called on every redraw."""
        if self.done.is_set():
            try:
                from prompt_toolkit.application.current import get_app
                get_app().loop.call_soon(self.exit_if_done)
            except Exception:          # noqa: BLE001
                pass
        frags: list = []
        tail = self._tail_ansi()
        if tail:
            frags.extend(to_formatted_text(ANSI(tail)))
        elif self.waiting:
            i = int(time.monotonic() / 0.08) % len(SPINNER_FRAMES)
            frags.extend([(f"fg:{PALETTE['ghost']}", SPINNER_FRAMES[i]),
                          (f"fg:{PALETTE['faint']}", " thinking…\n")])
        if frags:
            frags.append(("", "\n"))
        frags.append(("class:p", PROMPT_GLYPH))
        return frags


class _BusySpinner:
    """console.status's start/stop, drawn by the busy prompt's message."""

    def __init__(self, view: _BusyView):
        self.view = view

    def start(self) -> None:
        self.view.waiting = True
        self.view.invalidate()

    def stop(self) -> None:
        self.view.waiting = False
        self.view.invalidate()


