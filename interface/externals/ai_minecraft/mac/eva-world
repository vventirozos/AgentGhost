#!/bin/bash
# Eva's World from the Mac (eva), e.g. over ssh:
#
#   eva-world status            phase, session, where she is, what she is doing
#   eva-world start|stop|pause|resume
#   eva-world journal           her journal
#   eva-world reset [--yes]     stop + delete EVERYTHING (world, sessions,
#                               journal, body memory; no backup); the next
#                               start makes a new world
#
# Installed by install_mac.sh as ~/.local/bin/eva-world. Over a plain
# `ssh eva eva-world …` that directory may not be on PATH: use
# `ssh eva ~/.local/bin/eva-world …`.
set -euo pipefail

HUB="${EVA_WORLD_HUB:-http://100.83.184.117:8090}"
NOVA="${NOVA_HOST:-100.83.184.117}"
KEY_FILE="${EVA_WORLD_KEY_FILE:-$HOME/Data/AI/.world_hub_key}"
[ -r "$KEY_FILE" ] || { echo "eva-world: no hub key at $KEY_FILE (run deploy.sh)" >&2; exit 1; }
KEY="$(cat "$KEY_FILE")"

api() {  # api METHOD PATH [JSON] [TIMEOUT]
  local out code
  out="$(curl -sS -m "${4:-20}" -X "$1" -H "X-World-Key: $KEY" -H 'content-type: application/json' \
         ${3:+-d "$3"} -w '\n%{http_code}' "$HUB$2")" || { echo "eva-world: hub unreachable at $HUB" >&2; exit 1; }
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  if [ "$code" -ge 400 ]; then
    echo "eva-world: $(printf '%s' "$out" | /usr/bin/python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error") or "")
except Exception: print("")') (HTTP $code)" >&2
    exit 1
  fi
  printf '%s' "$out"
}

control() { api POST /api/control "{\"action\":\"$1\"}" "${2:-20}" >/dev/null; echo "$1: done"; }

status() {
  # macOS's /usr/bin/python3 is 3.9: no backslashes inside f-strings
  local j; j="$(api GET /api/status)" || exit 1
  STATUS_JSON="$j" /usr/bin/python3 - <<'PY'
import json, os
d = json.loads(os.environ["STATUS_JSON"])
line = "world:   " + d["phase"]
if d.get("session"):
    line += "  (session %s)" % d["session"]
print(line)
if d.get("error"):
    print("error:   " + d["error"])
g = (d.get("state") or {}).get("gameplay")
if g:
    p = g["position"]
    print("eva:     at %d, %d, %d (%s), health %s/20, food %s/20" % (round(p["x"]), round(p["y"]), round(p["z"]), g.get("biome"), g["health"], g["hunger"]))
    print("doing:   " + d["state"].get("action", {}).get("current", "?").replace("action:", ""))
if d.get("currentGoal"):
    print("goal:    " + d["currentGoal"])
print("mind:    " + (d.get("mind") or {}).get("status", "?"))
if d["phase"] == "running" and d.get("wakeAt"):
    print("looks:   next in ~%d min" % max(0, round((d["wakeAt"] - d["now"]) / 60000)))
PY
}

case "${1:-status}" in
  status) status ;;
  start) echo "starting (30-60 s)…"; control start 300; status ;;
  stop) control stop 120 ;;
  pause|resume) control "$1" ;;
  journal) api GET /api/journal; echo ;;
  reset)
    if [ "${2:-}" != "--yes" ]; then
      read -r -p "Delete the world, every session, Eva's journal and the body's memory (no backup)? Type yes: " a
      [ "$a" = "yes" ] || { echo "cancelled"; exit 1; }
    fi
    j="$(api GET /api/status)" || exit 1
    phase="$(printf '%s' "$j" | /usr/bin/python3 -c 'import json,sys;print(json.load(sys.stdin)["phase"])')"
    [ "$phase" = "stopped" ] || control stop 120
    ssh "$NOVA" '/bin/bash ~/Data/AI/World/app/scripts/reset_world.sh --yes'
    echo "reset: done. 'eva-world start' makes a new world." ;;
  -h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "eva-world: unknown command '$1' (status|start|stop|pause|resume|journal|reset)" >&2; exit 2 ;;
esac
