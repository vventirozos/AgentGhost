[Unit]
Description=ghost-labs lab container manager
After=network-online.target docker.service tailscaled.service ghost-labs-fw.service
Wants=network-online.target ghost-labs-fw.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/ghost-labs
ExecStartPre=/opt/ghost-labs/bin/wait-tailnet
# idempotent: re-ensure the firewall (anything that ran iptables-restore since boot may have flushed it)
ExecStartPre=/opt/ghost-labs/bin/ghost-labs-fw
ExecStart=/opt/ghost-labs/venv/bin/python -m ghost_labs.server
Restart=always
RestartSec=5
OOMScoreAdjust=-900
# the state dir holds secrets and backups: nothing it writes is group/world readable
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
